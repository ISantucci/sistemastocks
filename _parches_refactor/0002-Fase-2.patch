@@ -0,0 +1,190 @@
+"""Fase 2 — el mapa de stock deja de viajar entero dentro del HTML.
+
+Que se cubre:
+  - Por debajo del umbral NO cambia nada (mapas embebidos, como siempre).
+  - Por encima del umbral el HTML va sin mapa y marca el modo remoto.
+  - El endpoint /api/stock/by-location devuelve lo mismo que iba embebido.
+  - El endpoint respeta el alcance del TECNICO (si no, seria seguridad visual).
+"""
+import json
+import re
+
+import pytest
+from conftest import make_user, make_item, make_location, login
+
+
+@pytest.fixture()
+def esc(A):
+    A.app.config["WTF_CSRF_ENABLED"] = False
+
+    tec = make_user(A, "tec", "TECNICO")
+    make_user(A, "adm2", "ADMIN")
+
+    jaula = make_location(A, A.LOCATION_JAULA_TNG)
+    mi_cam = make_location(A, "Camioneta Mia", is_truck=True)
+    otra = make_location(A, "Camioneta Ajena", is_truck=True)
+
+    A.db.session.add(A.LocationResponsible(location_id=mi_cam.id, user_id=tec.id))
+    A.db.session.commit()
+
+    it_mio = make_item(A, code="MIO-001", name="Item mio")
+    it_ajeno = make_item(A, code="AJE-001", name="Item ajeno")
+    it_jaula = make_item(A, code="JAU-001", name="Item de jaula")
+
+    A.upsert_stock(it_mio.id, mi_cam.id, 7)
+    A.upsert_stock(it_ajeno.id, otra.id, 9)
+    A.upsert_stock(it_jaula.id, jaula.id, 100)
+    A.db.session.commit()
+
+    return {"tec": tec, "jaula": jaula, "mi_cam": mi_cam, "otra": otra,
+            "it_mio": it_mio, "it_ajeno": it_ajeno, "it_jaula": it_jaula}
+
+
+def _como(A, username):
+    c = A.app.test_client()
+    login(c, username)
+    return c
+
+
+def _var(html, nombre):
+    m = re.search(rf"var {nombre} = (.*?);\n", html, re.S)
+    return json.loads(m.group(1)) if m else None
+
+
+@pytest.fixture()
+def umbral(A):
+    """Permite mover STOCK_MAP_MAX_INLINE dentro de un test y restaurarlo."""
+    original = A.STOCK_MAP_MAX_INLINE
+    yield lambda v: setattr(A, "STOCK_MAP_MAX_INLINE", v)
+    A.STOCK_MAP_MAX_INLINE = original
+
+
+# ---------------------------------------------------------- modo embebido
+
+@pytest.mark.parametrize("ruta", ["/movements", "/item-usage", "/movements/bulk", "/scrap"])
+def test_por_debajo_del_umbral_sigue_embebido(A, esc, umbral, ruta):
+    """El default no debe cambiar el comportamiento historico."""
+    umbral(5000)
+    html = _como(A, "adm2").get(ruta).get_data(as_text=True)
+    assert _var(html, "stockQtyMap"), f"{ruta} dejo de embeber el mapa sin superar el umbral"
+
+
+def test_umbral_por_defecto_es_holgado(A):
+    """Guarda contra bajar el default sin querer: hoy hay ~400 filas en prod."""
+    assert A.STOCK_MAP_MAX_INLINE >= 1000
+
+
+# ------------------------------------------------------------ modo remoto
+
+@pytest.mark.parametrize("ruta", ["/movements", "/item-usage", "/movements/bulk", "/scrap"])
+def test_por_encima_del_umbral_el_html_va_sin_mapa(A, esc, umbral, ruta):
+    umbral(0)
+    html = _como(A, "adm2").get(ruta).get_data(as_text=True)
+    assert _var(html, "stockQtyMap") == {}
+    assert _var(html, "stockMap") == {}
+
+
+def _sembrar_stock(A, loc, n, prefijo):
+    cat = A.Category.query.first()
+    for i in range(n):
+        A.db.session.add(A.Item(code=f"{prefijo}-{i:04d}", name=f"Item {i}",
+                                category_id=cat.id, is_active=True))
+    A.db.session.commit()
+    for it in A.Item.query.filter(A.Item.code.like(f"{prefijo}-%")).all():
+        A.upsert_stock(it.id, loc.id, 5)
+    A.db.session.commit()
+
+
+def _peso_mapa(html):
+    m = re.search(r"var stockQtyMap = (.*?);\n", html, re.S)
+    return len(m.group(1).encode()) if m else 0
+
+
+def test_el_mapa_no_crece_con_el_inventario_en_modo_remoto(A, esc, umbral):
+    """La prueba de fondo de la Fase 2: mas stock no debe pesar mas mapa."""
+    umbral(0)
+    c = _como(A, "adm2")
+    antes = _peso_mapa(c.get("/movements").get_data(as_text=True))
+
+    _sembrar_stock(A, esc["jaula"], 300, "BULK")
+
+    despues = _peso_mapa(c.get("/movements").get_data(as_text=True))
+    assert despues == antes, "el mapa de stock volvio a crecer con el inventario"
+    assert _var(c.get("/movements").get_data(as_text=True), "stockQtyMap") == {}
+
+
+def test_en_modo_embebido_el_mapa_si_crece(A, esc, umbral):
+    """Contraprueba del test anterior: sin modo remoto, el problema existe.
+
+    Sirve para que el test de arriba no pase por accidente (por ejemplo si un dia
+    stockQtyMap deja de emitirse y ambos pesos dan 0).
+    """
+    umbral(999_999)
+    c = _como(A, "adm2")
+    antes = _peso_mapa(c.get("/movements").get_data(as_text=True))
+    _sembrar_stock(A, esc["jaula"], 300, "BULK")
+    assert _peso_mapa(c.get("/movements").get_data(as_text=True)) > antes * 5
+
+
+@pytest.mark.xfail(reason="Limitacion conocida: el <select> de items de estas 4 "
+                          "pantallas se sigue renderizando completo. No usan "
+                          "item_picker_options(). Queda como hallazgo aparte.",
+                   strict=True)
+def test_el_select_de_items_todavia_se_embebe_completo(A, esc, umbral):
+    """Documenta lo que la Fase 2 NO resolvio, para que no se pierda.
+
+    Medido: con 300 items el HTML de /movements crece ~64 KB aunque el mapa de
+    stock vaya vacio. El peso ya no viene del stock sino del catalogo.
+    """
+    umbral(0)
+    c = _como(A, "adm2")
+    antes = len(c.get("/movements").get_data())
+    _sembrar_stock(A, esc["jaula"], 300, "BULK")
+    despues = len(c.get("/movements").get_data())
+    assert despues - antes < 10_000
+
+
+# ------------------------------------------------------------- el endpoint
+
+def test_endpoint_devuelve_lo_mismo_que_iba_embebido(A, esc):
+    c = _como(A, "adm2")
+    embebido = _var(c.get("/movements").get_data(as_text=True), "stockQtyMap")
+
+    r = c.get(f"/api/stock/by-location?location_id={esc['jaula'].id}")
+    assert r.status_code == 200
+    assert r.get_json()["qty"] == embebido[str(esc["jaula"].id)]
+    assert esc["it_jaula"].id in r.get_json()["items"]
+
+
+def test_endpoint_requiere_login(A, esc):
+    r = A.app.test_client().get(f"/api/stock/by-location?location_id={esc['jaula'].id}")
+    assert r.status_code in (301, 302, 401)
+
+
+@pytest.mark.parametrize("valor", ["", "abc", "-1", "999999", "1 OR 1=1"])
+def test_endpoint_tolera_basura(A, esc, valor):
+    r = _como(A, "adm2").get("/api/stock/by-location", query_string={"location_id": valor})
+    assert r.status_code == 200
+    assert r.get_json() == {"items": [], "qty": {}} or r.get_json()["items"] == []
+
+
+# ------------------------------------------- alcance del tecnico en la API
+
+def test_tecnico_accede_a_su_ubicacion(A, esc):
+    r = _como(A, "tec").get(f"/api/stock/by-location?location_id={esc['mi_cam'].id}")
+    assert r.status_code == 200
+    assert esc["it_mio"].id in r.get_json()["items"]
