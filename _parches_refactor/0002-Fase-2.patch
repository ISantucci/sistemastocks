+/* ---------- Carga del mapa de stock bajo demanda (Fase 2) ----------
+ *
+ * Historico: el servidor embebia la tabla `stock` COMPLETA dentro del HTML de
+ * cada pantalla de carga. El peso crecia de forma lineal con el inventario, en
+ * cada request, sin cachear.
+ *
+ * Ahora, si el servidor decide que el mapa es demasiado grande (ver
+ * STOCK_MAP_MAX_INLINE en app.py) manda los mapas VACIOS y marca remote=true.
+ * En ese caso se pide solo la ubicacion elegida, cuando se la elige.
+ *
+ * Por debajo del umbral el servidor sigue embebiendo todo y esta funcion es un
+ * passthrough: el comportamiento es identico al de siempre.
+ */
+function makeStockLoader(stockMap, stockQtyMap, remote, url) {
+  var pendientes = {};
+  url = url || "/api/stock/by-location";
+
+  return function ensureStock(locId, cb) {
+    locId = String(locId == null ? "" : locId);
+    // Sin modo remoto, sin ubicacion, o ya cacheada: seguir de largo.
+    if (!remote || !locId || stockMap[locId] !== undefined) {
+      if (cb) cb();
+      return;
+    }
+    if (pendientes[locId]) { pendientes[locId].push(cb); return; }
+    pendientes[locId] = [cb];
+
+    var terminar = function () {
+      var cbs = pendientes[locId] || [];
+      delete pendientes[locId];
+      cbs.forEach(function (f) { if (f) f(); });
+    };
+
+    fetch(url + "?location_id=" + encodeURIComponent(locId), {
+      credentials: "same-origin",
+      headers: { "Accept": "application/json" }
+    })
+      .then(function (r) { return r.ok ? r.json() : { items: [], qty: {} }; })
+      .then(function (d) {
+        stockMap[locId] = d.items || [];
+        stockQtyMap[locId] = d.qty || {};
+      })
+      .catch(function () {
+        // Ante un error de red no inventamos stock: la ubicacion queda vacia.
+        stockMap[locId] = [];
+        stockQtyMap[locId] = {};
+      })
+      .then(terminar, terminar);
+  };
+}
