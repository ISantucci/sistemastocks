+# Cuantas filas de stock se pueden embeber en el HTML antes de pasar a modo
+# remoto. Mismo criterio que ITEM_PICKER_MAX_INLINE: por debajo del umbral el
+# comportamiento es EXACTAMENTE el historico (todo embebido); por encima, el
+# navegador pide solo la ubicacion que el usuario elige.
+#
+# El default (5000) esta muy por encima del volumen actual (~400 filas medidas
+# el 2026-08-18), asi que hoy no cambia nada. Lo nuevo se activa por opcion, no
+# por sorpresa. Bajarlo a 0 fuerza el modo remoto (util para probarlo).
+STOCK_MAP_MAX_INLINE = int(os.environ.get("STOCK_MAP_MAX_INLINE", "5000"))
+
+
+def stock_maps_for_render(location_ids=None):
+    """Igual que build_stock_maps() pero decide si conviene embeber o no.
+
+    Devuelve (stock_map, stock_qty_map, remoto):
+      - remoto=False -> mapas completos, como siempre.
+      - remoto=True  -> mapas VACIOS; el front los pide por /api/stock/by-location
+        a medida que el usuario elige la ubicacion de origen.
+    """
+    q = Stock.query.filter(Stock.quantity > 0)
+    if location_ids is not None:
+        ids = list(location_ids) or [-1]
+        q = q.filter(Stock.location_id.in_(ids))
+
+    if q.order_by(None).count() > STOCK_MAP_MAX_INLINE:
+        return {}, {}, True
+
+    stock_map, stock_qty_map = build_stock_maps(location_ids)
+    return stock_map, stock_qty_map, False
+
+
+@app.route("/api/stock/by-location")
+@login_required
+def api_stock_by_location():
+    """Stock de UNA ubicacion, para el modo remoto del selector de items.
+
+    El alcance se resuelve con la misma regla que las pantallas: si el usuario es
+    TECNICO y pide una ubicacion de la que no es responsable, la respuesta es
+    vacia. Dejar la API abierta y acotar solo el HTML seria seguridad visual.
+    """
+    raw = (request.args.get("location_id") or "").strip()
+    if not raw.isdigit():
+        return jsonify({"items": [], "qty": {}})
+
+    loc_id = int(raw)
+    if getattr(current_user, "role", None) == "TECNICO":
+        if loc_id not in set(tech_location_ids_for(current_user)):
+            return jsonify({"items": [], "qty": {}})
+
+    stock_map, stock_qty_map = build_stock_maps(location_ids=[loc_id])
+    return jsonify({
+        "items": stock_map.get(loc_id, []),
+        "qty": stock_qty_map.get(str(loc_id), {}),
+    })
+
