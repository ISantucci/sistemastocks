 /stock-alerts + fin del N+1 de RemitoLine

---
 app.py                          |  37 +++++++++++-
 templates/ingresos_egresos.html |   2 +
 templates/stock_alerts.html     |   2 +
 tests/test_pagination.py        | 102 ++++++++++++++++++++++++++++++++
 4 files changed, 140 insertions(+), 3 deletions(-)

diff --git a/app.py b/app.py
index 655506d..16ac0cf 100644
--- a/app.py
+++ b/app.py
@@ -6244,6 +6244,18 @@ def stock_alerts():
     keyfn = keyfns.get(sort_by, keyfns["code"])
     alerts.sort(key=keyfn, reverse=(sort_dir == "desc"))
 
+    # Paginacion en memoria, a proposito: is_alert_stock() es una regla de
+    # negocio en Python (no se puede expresar en SQL sin duplicarla), asi que la
+    # lista se filtra y se ordena entera y despues se corta. Acota el HTML, que
+    # es lo que crecia sin limite. La consulta sigue trayendo el universo de
+    # items con stock_min > 0, que es un subconjunto chico y acotado del catalogo.
+    _total = len(alerts)
+    _per_page = per_page_from_request()
+    _page = page_from_request()
+    _desde = (_page - 1) * _per_page
+    alerts_page = PageResult(alerts[_desde:_desde + _per_page], _page, _per_page, _total)
+    alerts = alerts_page.items
+
     locations_list = Location.query.order_by(Location.name).all()
     items_list = Item.query.filter_by(is_active=True).order_by(Item.code).all()
     categories_list = Category.query.order_by(Category.name).all()
@@ -6251,6 +6263,7 @@ def stock_alerts():
     return render_template(
         "stock_alerts.html",
         alerts=alerts,
+        page_obj=alerts_page,
         locations=locations_list,
         items=items_list,
         categories=categories_list,
@@ -7981,12 +7994,29 @@ def in_out():
     suppliers_list = Supplier.query.filter_by(is_active=True).order_by(Supplier.contact_name).all()
     items_list = Item.query.filter_by(is_active=True).order_by(Item.code).all()
 
-    logs = (
+    # Antes: .limit(300).all(). Ese tope ESCONDIA filas sin avisar -- no habia
+    # "pagina 2" ni aviso -- lo cual en un sistema de trazabilidad es peor que
+    # paginar: el que mira la pantalla cree que esta viendo todo. Ahora es
+    # paginacion real, con el mismo helper que el resto de los listados.
+    logs_q = (
         Movement.query.filter(Movement.supplier_id.isnot(None))
-        .order_by(Movement.created_at.desc()).limit(300).all()
+        .order_by(Movement.created_at.desc())
     )
+    logs_page = paginate(logs_q)
+    logs = logs_page.items
+
     # Remito por movimiento (para el link/estado de impresion).
-    line_map = {ln.movement_id: ln.remito for ln in RemitoLine.query.all()}
+    # Antes: RemitoLine.query.all(), que traia la tabla ENTERA y ademas disparaba
+    # un SELECT por cada ln.remito (N+1). Ahora solo las lineas de los
+    # movimientos de esta pagina, con el remito ya cargado.
+    line_map = {}
+    if logs:
+        _ids = [m.id for m in logs]
+        for ln in (RemitoLine.query
+                   .options(db.joinedload(RemitoLine.remito))
+                   .filter(RemitoLine.movement_id.in_(_ids))
+                   .all()):
+            line_map[ln.movement_id] = ln.remito
 
     # Seriales disponibles en Jaula (para egreso de serializados).
     jaula_units = {}
@@ -8010,6 +8040,7 @@ def in_out():
         items=items_list,
         jaula_stock=jaula_stock,
         logs=logs,
+        page_obj=logs_page,
         line_map=line_map,
         jaula_units=jaula_units,
         serialized_item_ids=serialized_item_ids,
