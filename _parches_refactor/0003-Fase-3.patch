diff --git a/tests/test_pagination.py b/tests/test_pagination.py
index f6fad2c..244a8d1 100644
--- a/tests/test_pagination.py
+++ b/tests/test_pagination.py
@@ -201,3 +201,105 @@ def test_selector_items_pasa_a_remoto_con_catalogo_grande(admin, monkeypatch):
     assert "js-buscar-remoto" in html
     assert "/api/items/search" in html
     assert "CAB-004" not in html, "el catálogo no debe volcarse en el HTML"
+
+
+# ------------------------------------------------- /ingresos-egresos (Fase 3)
+#
+# Esta pantalla tenia un .limit(300) fijo que escondia filas SIN AVISAR: no
+# habia "pagina 2" ni mensaje. En un sistema de trazabilidad eso es peor que
+# paginar, porque el que mira cree que esta viendo todo.
+
+
+def _sembrar_in_out(A, n):
+    """n movimientos con proveedor (los que lista Ingresos/Egresos)."""
+    jaula = make_location(A, A.LOCATION_JAULA_TNG)
+    prov = make_location(A, A.LOCATION_PROVEEDOR, is_external=True)
+    it = make_item(A, code="IO-001", name="Item IO")
+    s = A.Supplier(contact_name="Proveedor Uno")
+    A.db.session.add(s)
+    A.db.session.commit()
+    for i in range(n):
+        A.db.session.add(A.Movement(
+            item_id=it.id, qty=1,
+            from_location_id=prov.id, to_location_id=jaula.id,
+            user_id=1, supplier_id=s.id,
+            year=2026, seq=i + 1, number=f"MOV-{i + 1:03d}",
+        ))
+    A.db.session.commit()
+    return it
+
+
+def test_ingresos_egresos_pagina(admin):
+    A, c = admin
+    _sembrar_in_out(A, 40)
+    html = c.get("/ingresos-egresos?limit=10").get_data(as_text=True)
+    assert _rows_en_tabla(html) == 10
+
+
+def test_ingresos_egresos_ya_no_esconde_filas(admin):
+    """El tope mudo de 300 no debe volver: la fila 301 tiene que ser alcanzable."""
+    A, c = admin
+    _sembrar_in_out(A, 305)
+
+    total_visto = 0
+    for page in range(1, 5):
+        html = c.get(f"/ingresos-egresos?limit=100&page={page}").get_data(as_text=True)
+        total_visto += _rows_en_tabla(html)
+    assert total_visto == 305, f"se perdieron filas: {total_visto} de 305"
+
+
+def test_ingresos_egresos_declara_el_total(admin):
+    """La barra de paginacion tiene que decir cuantas filas hay en serio."""
+    A, c = admin
+    _sembrar_in_out(A, 305)
+    html = c.get("/ingresos-egresos?limit=50").get_data(as_text=True)
+    assert "305" in html, "el total real no aparece en la pantalla"
+
+
+def test_ingresos_egresos_no_carga_toda_la_tabla_de_lineas(admin):
+    """line_map debe acotarse a la pagina, no a RemitoLine entero."""
+    A, c = admin
+    it = _sembrar_in_out(A, 40)
+    # Un remito con una linea de un movimiento que NO esta en la pagina 1.
+    viejo = A.Movement.query.order_by(A.Movement.id.asc()).first()
+    rem = A.Remito(number="R-0001", year=2026, seq=1,
+                   from_location_id=viejo.from_location_id,
+                   to_location_id=viejo.to_location_id,
+                   created_by_user_id=1)
+    A.db.session.add(rem)
+    A.db.session.commit()
+    A.db.session.add(A.RemitoLine(remito_id=rem.id, movement_id=viejo.id))
+    A.db.session.commit()
+
+    r = c.get("/ingresos-egresos?limit=5")
+    assert r.status_code == 200
+
+
+# ------------------------------------------------------ /stock-alerts (Fase 3)
+
+
+def test_stock_alerts_pagina(admin):
+    A, c = admin
+    loc = make_location(A, "Deposito Alertas")
+    for i in range(30):
+        it = make_item(A, code=f"AL-{i:03d}", name=f"Alerta {i}", stock_min=10)
+        A.upsert_stock(it.id, loc.id, 1)   # por debajo del minimo => alerta
+    A.db.session.commit()
+
+    html = c.get("/stock-alerts?limit=10").get_data(as_text=True)
+    assert _rows_en_tabla(html) == 10
+
+
+def test_stock_alerts_no_pierde_alertas_al_paginar(admin):
+    A, c = admin
+    loc = make_location(A, "Deposito Alertas")
+    for i in range(30):
+        it = make_item(A, code=f"AL-{i:03d}", name=f"Alerta {i}", stock_min=10)
+        A.upsert_stock(it.id, loc.id, 1)
+    A.db.session.commit()
+
+    vistos = 0
+    for page in (1, 2, 3):
+        html = c.get(f"/stock-alerts?limit=10&page={page}").get_data(as_text=True)
+        vistos += _rows_en_tabla(html)
+    assert vistos == 30
