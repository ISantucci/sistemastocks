+def build_stock_maps(location_ids=None):
+    """Mapas de stock para los selectores de las pantallas de carga.
+
+    Devuelve (stock_map, stock_qty_map):
+      - stock_map     -> { loc_id(int): [item_id, ...] }        filtra el select "Item"
+      - stock_qty_map -> { loc_id(str): { item_id(str): qty } } tope de cantidad
+
+    location_ids: si se pasa, limita a esas ubicaciones (ej. camionetas del
+    tecnico). Si es None devuelve todo, que es el comportamiento historico y el
+    que siguen viendo ADMIN / SUPERVISOR / LECTOR.
+
+    Este helper existe para que el alcance viva en UN solo lugar. Antes el bloque
+    estaba copiado en cuatro handlers y ninguna copia filtraba, mientras que
+    build_units_map() -- tres lineas mas abajo en el mismo handler -- si lo
+    hacia. Resultado: el TECNICO recibia el stock de TODAS las ubicaciones,
+    incluidas camionetas ajenas. La pantalla no lo mostraba, pero el dato viajaba
+    en el HTML y se leia con F12: seguridad visual, no real.
+    """
+    q = Stock.query.filter(Stock.quantity > 0)
+    if location_ids is not None:
+        ids = list(location_ids) or [-1]
+        q = q.filter(Stock.location_id.in_(ids))
+
+    stock_map = {}
+    stock_qty_map = {}
+    for s in q.all():
+        stock_map.setdefault(s.location_id, []).append(s.item_id)
+        stock_qty_map.setdefault(str(s.location_id), {})[str(s.item_id)] = s.quantity
+    return stock_map, stock_qty_map
+
