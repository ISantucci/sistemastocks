+# --------------------------------------- regla 2 (bis): el mapa de stock del HTML
+#
+# Estos tests cubren el agujero real que existia antes de la Fase 1: la pantalla
+# NO mostraba el stock ajeno, pero el dato viajaba igual dentro del <script> y se
+# leia con F12. No alcanza con mirar la tabla: hay que mirar lo que se serializa.
+
+
+def _stock_qty_map(html):
+    """Extrae la variable stockQtyMap embebida en el HTML."""
+    m = re.search(r"var stockQtyMap = (.*?);\n", html, re.S)
+    return json.loads(m.group(1)) if m else None
+
+
+@pytest.mark.parametrize("ruta", ["/movements", "/item-usage"])
+def test_tecnico_no_recibe_stock_de_ubicaciones_ajenas(A, esc, ruta):
+    """El HTML no debe contener el stock de la camioneta del otro tecnico."""
+    html = _como(A, "tec_a").get(ruta).get_data(as_text=True)
+    mapa = _stock_qty_map(html)
+    assert mapa is not None, f"{ruta} ya no embebe stockQtyMap: revisar este test"
+
+    ajenas = {str(esc["truck_b"].id), str(esc["dep"].id)}
+    assert not (set(mapa) & ajenas), (
+        f"{ruta} le filtro al tecnico ubicaciones ajenas: {set(mapa) & ajenas}"
+    )
+    assert str(esc["truck_a"].id) in mapa, "el tecnico perdio SU propia ubicacion"
+
+
+@pytest.mark.parametrize("ruta", ["/movements", "/item-usage"])
+def test_tecnico_no_recibe_cantidades_de_items_ajenos(A, esc, ruta):
+    """Ni el item de la otra camioneta ni el del deposito deben aparecer."""
+    html = _como(A, "tec_a").get(ruta).get_data(as_text=True)
+    mapa = _stock_qty_map(html)
+    visibles = {int(i) for por_loc in mapa.values() for i in por_loc}
+    assert esc["it_b"].id not in visibles
+    assert esc["it_dep"].id not in visibles
+    assert esc["it_a"].id in visibles
+
+
+@pytest.mark.parametrize("ruta", ["/movements", "/item-usage"])
+def test_admin_sigue_viendo_el_mapa_completo(A, esc, ruta):
+    """Contraprueba: para ADMIN nada cambia respecto del comportamiento previo."""
+    make_user(A, "adm2", "ADMIN")
+    html = _como(A, "adm2").get(ruta).get_data(as_text=True)
+    mapa = _stock_qty_map(html)
+    for loc in ("truck_a", "truck_b", "dep"):
+        assert str(esc[loc].id) in mapa, f"ADMIN perdio {loc}: regresion"
+
+
+def test_tecnico_sin_ubicacion_no_recibe_nada(A, esc):
+    """Sin ubicaciones asignadas el mapa va vacio, no completo."""
+    make_user(A, "tec_solo", "TECNICO")
+    html = _como(A, "tec_solo").get("/movements").get_data(as_text=True)
+    assert _stock_qty_map(html) == {}
+
+
+def test_build_stock_maps_filtra_por_ubicacion(A, esc):
+    """Prueba directa del helper, sin pasar por HTTP."""
+    with A.app.app_context():
+        completo, _ = A.build_stock_maps()
+        acotado, qty = A.build_stock_maps(location_ids=[esc["truck_a"].id])
+        assert set(acotado) == {esc["truck_a"].id}
