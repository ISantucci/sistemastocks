+"""Fase 5 (paso 1) — sacar de app.py lo que no depende del resto.
+
+Criterio: SOLO mover codigo. Ni una linea de logica cambia. Son dos bloques que
+no tienen acoplamiento real con los handlers:
+
+  - migraciones.py : ensure_sqlite_schema(), 235 lineas de sqlite3 puro.
+  - modelos.py     : las 21 clases del ORM + sus helpers.
+
+Lo que NO se hace acá es partir las rutas en blueprints. Motivo concreto: un
+blueprint renombra los endpoints ('metricas' pasa a ser 'metricas.metricas'),
+asi que habria que tocar todos los url_for() de los 47 templates y de la suite
+en el mismo commit. Es un diff enorme, dificil de revisar y de revertir, y su
+beneficio es de mantenibilidad interna, no de la operacion. Va aparte y despues
+de que estas fases esten estables.
+"""
+import re
+
+src = open("app.py", encoding="utf-8").read()
+lineas = src.split("\n")
+
+
+def indice(pred, desde=0):
+    for i in range(desde, len(lineas)):
+        if pred(lineas[i]):
+            return i
+    raise AssertionError("no encontrado")
+
+
+# ------------------------------------------------------------- migraciones
+ini_mig = indice(lambda l: l.startswith("# ------------------ MIGRACIONES SQLITE"))
+fin_mig = indice(lambda l: l.startswith("# ------------------ HELPERS: OPERACIONES DESTRUCTIVAS"))
+bloque_mig = "\n".join(lineas[ini_mig:fin_mig]).strip()
+
+# ------------------------------------------------------------------ modelos
+ini_mod = indice(lambda l: l.startswith("# ------------------ MODELOS"))
+fin_mod = indice(lambda l: l.startswith("# ------------------ LOGIN MANAGER"))
+bloque_mod = "\n".join(lineas[ini_mod:fin_mod]).strip()
+
+# Se saca de abajo hacia arriba para no correr los indices.
+nuevas = lineas[:ini_mod] + [
+    "# ------------------ MODELOS ------------------",
+    "# Las 21 clases del ORM viven en modelos.py desde la Fase 5. Se importan con",
+    "# * a proposito: asi `app.Item`, `app.Stock`, etc. siguen resolviendo igual",
+    "# que cuando estaban escritas aca, y ni la suite ni serve.py se enteran.",
+    "from modelos import *  # noqa: F401,F403",
+    "from modelos import (  # noqa: F401  (explicito para los linters)",
+    "    Location, User, Supplier, LocationResponsible, Category, Item,",
+    "    ItemSupplier, ItemUnit, Stock, Movement, PendingDelivery, Remito,",
+    "    RemitoLine, Scrap, Repair, PurchaseRequest, PurchaseRequestLine,",
+    "    PurchaseRequestRecipient, RepairRequest, RepairRequestLine,",
+    "    UNIT_EN_STOCK, UNIT_ENTREGADO, UNIT_DESCARTADO,",
+    "    item_supplier_names, apply_item_suppliers,",
+    ")",
+    "",
+    "",
+] + lineas[fin_mod:]
+
+# recalcular los limites de migraciones sobre la lista nueva
+lineas = nuevas
+ini_mig = indice(lambda l: l.startswith("# ------------------ MIGRACIONES SQLITE"))
+fin_mig = indice(lambda l: l.startswith("# ------------------ HELPERS: OPERACIONES DESTRUCTIVAS"))
+
+lineas = lineas[:ini_mig] + [
+    "# ------------------ MIGRACIONES SQLITE (best-effort) ------------------",
+    "# El migrador vive en migraciones.py desde la Fase 5. Se re-exporta con el",
+    "# mismo nombre porque serve.py y el bloque __main__ lo importan de app.",
+    "from migraciones import ensure_sqlite_schema  # noqa: F401",
+    "",
+    "",
+] + lineas[fin_mig:]
+
+open("app.py", "w", encoding="utf-8").write("\n".join(lineas))
+
+# ------------------------------------------------------------ modelos.py
+cab_mod = '''"""Modelos del dominio (ORM).
+
+Extraido de app.py en la Fase 5 SIN cambiar una linea de logica: es el mismo
+codigo, movido. app.py lo reimporta con `from modelos import *`, asi que todo lo
+que antes se accedia como `app.Item` sigue funcionando igual.
+
+Por que se separo primero esto y no las rutas: los modelos no dependen de nada
+del resto del sistema (solo de `db` y de utilidades de fecha/hash), asi que
+moverlos no puede romper un handler. Las rutas, en cambio, arrastran los
+endpoints de url_for(), que es otra conversacion.
+"""
+from datetime import datetime, timezone, timedelta
+
+from werkzeug.security import generate_password_hash, check_password_hash
+
+from extensiones import db
+
+
+# Hora local Argentina (UTC-3, sin horario de verano). Offset fijo para no
+# depender de la zona horaria del sistema/contenedor ni de librerias externas.
+AR_TZ = timezone(timedelta(hours=-3))
+
+
+def now_ar():
+    """Fecha/hora actual en hora argentina, naive (para guardar y mostrar)."""
+    return datetime.now(AR_TZ).replace(tzinfo=None)
+
+
+'''
+open("modelos.py", "w", encoding="utf-8").write(cab_mod + bloque_mod + "\n")
+
+# --------------------------------------------------------- migraciones.py
+cab_mig = '''"""Migraciones de esquema para SQLite (best-effort).
+
+Extraido de app.py en la Fase 5 SIN cambiar una linea: es el mismo codigo.
+Se movio primero porque no depende de nada del sistema salvo la ruta del .db:
+abre sqlite3 directo, mira sqlite_master y agrega columnas faltantes.
+
+OJO: sigue siendo solo ADITIVO (no renombra, no cambia tipos, no toca
+constraints) y no versiona el esquema. Migrar esto a una herramienta real
+(Alembic / Flask-Migrate) es una tarea aparte, con su propio riesgo, y esta
+anotada en el vault.
+"""
+import sqlite3
+
+from rutas_datos import DB_PATH
+
+
+'''
+open("migraciones.py", "w", encoding="utf-8").write(cab_mig + bloque_mig + "\n")
+
+print("app.py:", len(open("app.py", encoding="utf-8").read().split("\n")), "lineas")
+print("modelos.py:", len(open("modelos.py", encoding="utf-8").read().split("\n")), "lineas")
+print("migraciones.py:", len(open("migraciones.py", encoding="utf-8").read().split("\n")), "lineas")
