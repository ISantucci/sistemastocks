--- a/static/js/app.js
+++ b/static/js/app.js
@@ -260,3 +260,58 @@ function leerDatos(id, porDefecto) {
     return porDefecto === undefined ? {} : porDefecto;
   }
 }
+
+/* ---------- Selector de items acotado por ubicacion de origen (Fase 6) ----------
+ *
+ * Las pantallas de carga (movimientos, lote, utilizados, descartes, ingresos)
+ * volcaban el catalogo COMPLETO en <option> y despues el JS descartaba en el
+ * navegador los items sin stock en el origen elegido. Con 25.000 items eso son
+ * ~4 MB de HTML por pantalla, en cada request, para terminar mostrando unas
+ * pocas opciones.
+ *
+ * Ahora, cuando el catalogo supera ITEM_PICKER_MAX_INLINE, el servidor no manda
+ * ninguna opcion y el select las pide a /api/items/search filtrando por la
+ * ubicacion de origen. El filtrado pasa a hacerse donde estan los datos.
+ *
+ * Debajo del umbral no se usa nada de esto: sigue el camino de siempre.
+ */
+function tomSelectItemsRemoto(el, src, extra) {
+  var opciones = Object.assign({}, window.TS_SINGLE_OPTS, {
+    valueField: "id",
+    labelField: "label",
+    searchField: ["code", "name"],
+    preload: "focus",
+    loadThrottle: 250,
+    sortField: null,            // el backend ya devuelve ordenado por codigo
+    placeholder: "Elegí la ubicación de origen primero...",
+    load: function (query, callback) {
+      var loc = el.getAttribute("data-location") || "";
+      if (!loc) { callback(); return; }
+      fetch(src + "?location_id=" + encodeURIComponent(loc) +
+            "&q=" + encodeURIComponent(query), {
+        credentials: "same-origin",
+        headers: { "Accept": "application/json" }
+      })
+        .then(function (r) { return r.ok ? r.json() : []; })
+        .then(function (filas) { callback(filas || []); })
+        .catch(function () { callback(); });
+    }
+  }, extra || {});
+  return new TomSelect(el, opciones);
+}
+
+/* Reapunta un selector remoto a otra ubicacion de origen. */
+function reiniciarSelectorRemoto(el, locId) {
+  if (!el) return;
+  locId = String(locId || "");
+  el.setAttribute("data-location", locId);
+
+  var ts = el.tomselect;
+  if (!ts) return;
+  ts.clear(true);
+  ts.clearOptions();
+  // TomSelect cachea los resultados por texto buscado. Si no se vacia, al
+  // cambiar de ubicacion sigue ofreciendo los items de la anterior.
+  ts.loadedSearches = {};
+  if (locId) { ts.enable(); ts.load(""); } else { ts.disable(); }
+}
