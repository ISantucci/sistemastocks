+"""Verificacion REAL en navegador de la Fase 2 (Chromium headless).
+
+Los tests de pytest prueban el servidor. Esto prueba lo que el pytest no puede:
+que el JavaScript de la pantalla de movimientos siga funcionando igual en los
+dos modos (mapa embebido y mapa remoto).
+
+Base sintetica y temporal. No toca ningun dato real.
+"""
+import json
+import os
+import re
+import sys
+import tempfile
+import threading
+import time
+from wsgiref.simple_server import make_server
+
+MODO_REMOTO = os.environ.get("MODO", "embebido") == "remoto"
+
+_T = tempfile.mkdtemp(prefix="verif_")
+os.environ.update(
+    STOCKS_DB_PATH=os.path.join(_T, "data", "s.db"),
+    STOCKS_BACKUP_DIR=os.path.join(_T, "b"),
+    STOCKS_LOG_DIR=os.path.join(_T, "l"),
+    FLASK_SECRET_KEY="verificacion",
+    APP_DEBUG="false",
+    RATELIMIT_ENABLED="false",
+    STOCK_MAP_MAX_INLINE="0" if MODO_REMOTO else "5000",
+)
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import app as A  # noqa: E402
+
+DATOS = {}
+
+
+def sembrar():
+    with A.app.app_context():
+        A.db.drop_all()
+        A.db.create_all()
+        A.seed_defaults()
+
+        cat = A.Category(name="Cables", prefix="CAB")
+        A.db.session.add(cat)
+        A.db.session.commit()
+
+        jaula = A.Location.query.filter_by(name=A.LOCATION_JAULA_TNG).first()
+        if not jaula:
+            jaula = A.Location(name=A.LOCATION_JAULA_TNG)
+            A.db.session.add(jaula)
+            A.db.session.commit()
+
+        cam_a = A.Location(name="Camioneta A", is_truck=True)
+        cam_b = A.Location(name="Camioneta B", is_truck=True)
+        A.db.session.add_all([cam_a, cam_b])
+        A.db.session.commit()
+
+        it_a = A.Item(code="AAA-001", name="Item de A", category_id=cat.id, is_active=True)
+        it_b = A.Item(code="BBB-001", name="Item de B", category_id=cat.id, is_active=True)
+        it_j = A.Item(code="JJJ-001", name="Item de Jaula", category_id=cat.id, is_active=True)
+        A.db.session.add_all([it_a, it_b, it_j])
+        A.db.session.commit()
+
+        A.upsert_stock(it_a.id, cam_a.id, 7)
+        A.upsert_stock(it_b.id, cam_b.id, 9)
+        A.upsert_stock(it_j.id, jaula.id, 55)
+        A.db.session.commit()
+
+        u = A.User(username="adm2", full_name="Admin Dos", role="ADMIN")
+        u.set_password("pass1234")
+        A.db.session.add(u)
+        A.db.session.commit()
+
+        DATOS.update(
+            cam_a=cam_a.id, cam_b=cam_b.id, jaula=jaula.id,
+            it_a=f"{it_a.code} - {it_a.name}", it_b=f"{it_b.code} - {it_b.name}",
+            it_j=f"{it_j.code} - {it_j.name}",
+        )
+
+
+def servir(puerto):
+    srv = make_server("127.0.0.1", puerto, A.app)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    time.sleep(0.6)
+    return srv
+
+
+FALLAS = []
+
+
+def chequear(cond, msg):
+    print(("  OK   " if cond else "  FALLA") + f"  {msg}")
+    if not cond:
+        FALLAS.append(msg)
+
+
+def main():
+    sembrar()
+    puerto = 5099
+    servir(puerto)
+    base = f"http://127.0.0.1:{puerto}"
+
+    from playwright.sync_api import sync_playwright
+
+    with sync_playwright() as pw:
+        nav = pw.chromium.launch(executable_path="/opt/pw-browsers/chromium-1194/chrome-linux/chrome")
+        pag = nav.new_page()
+
+        llamadas_api = []
+        pag.on("request", lambda r: llamadas_api.append(r.url)
+               if "/api/stock/by-location" in r.url else None)
+        errores_js = []
+        pag.on("pageerror", lambda e: errores_js.append(str(e)))
+
+        # --- login ---
+        pag.goto(f"{base}/login")
+        pag.fill('input[name="username"]', "adm2")
+        pag.fill('input[name="password"]', "pass1234")
+        pag.click('button[type="submit"], input[type="submit"]')
+        pag.wait_for_load_state("networkidle")
+
+        # --- movimientos ---
+        pag.goto(f"{base}/movements")
+        pag.wait_for_load_state("networkidle")
+
+        # Las variables viven dentro del callback de DOMContentLoaded, asi que no
+        # son globales: se leen del HTML servido, que es justo lo que ve el F12.
+        fuente = pag.content()
+        m = re.search(r'<script type="application/json" id="[\w-]+-datos">\s*(.*?)\s*</script>',
+                      fuente, re.S)
+        embebido = len(json.loads(m.group(1)).get("stockQtyMap", {})) if m else -1
+        chequear(
+            (embebido == 0) if MODO_REMOTO else (embebido > 0),
+            f"mapa inicial: {embebido} ubicaciones (modo {'remoto' if MODO_REMOTO else 'embebido'})",
+        )
+
+        # elegir Camioneta A como origen
+        pag.select_option("#from_location_id", str(DATOS["cam_a"]))
+        pag.wait_for_timeout(900)
+
+        opciones = pag.evaluate(
+            "Object.values(document.getElementById('item_id').tomselect.options)"
+            ".map(function(o){return o.text;})"
+        )
+        chequear(DATOS["it_a"] in opciones, f"ofrece el item de Camioneta A -> {opciones}")
+        chequear(DATOS["it_b"] not in opciones, "NO ofrece el item de Camioneta B")
+        chequear(DATOS["it_j"] not in opciones, "NO ofrece el item de la Jaula")
+
+        # tope de cantidad
+        pag.evaluate(
+            "var ts = document.getElementById('item_id').tomselect;"
+            "var op = Object.values(ts.options).find("
+            "  function(o){ return o.text.indexOf('AAA-001') === 0; });"
+            "ts.setValue(op.value);"
+        )
+        pag.wait_for_timeout(400)
+        mx = pag.get_attribute("#qty_input", "max")
+        chequear(mx == "7", f"tope de cantidad = {mx} (esperado 7)")
+
+        # cambiar a la Jaula
+        pag.select_option("#from_location_id", str(DATOS["jaula"]))
+        pag.wait_for_timeout(900)
+        opciones2 = pag.evaluate(
+            "Object.values(document.getElementById('item_id').tomselect.options)"
+            ".map(function(o){return o.text;})"
+        )
+        chequear(DATOS["it_j"] in opciones2, "al cambiar a Jaula ofrece su item")
+        chequear(DATOS["it_a"] not in opciones2, "al cambiar a Jaula ya no ofrece el de Camioneta A")
+
+        if MODO_REMOTO:
+            chequear(len(llamadas_api) >= 2, f"pidio la API por ubicacion ({len(llamadas_api)} veces)")
+        else:
+            chequear(len(llamadas_api) == 0, "modo embebido: no pide la API (0 requests)")
+
+        chequear(not errores_js, f"sin errores de JS ({errores_js})")
+
+        nav.close()
+
+    print()
+    if FALLAS:
+        print(f"RESULTADO: {len(FALLAS)} FALLAS")
+        sys.exit(1)
+    print("RESULTADO: todo OK")
+
+
+if __name__ == "__main__":
+    print(f"=== Verificacion en navegador — modo {'REMOTO' if MODO_REMOTO else 'EMBEBIDO'} ===")
+    main()
