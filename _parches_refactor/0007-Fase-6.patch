+def opciones_items_para_select(query, sin_serializados=False):
+    """(opciones, remoto) para el selector de items de las pantallas de carga.
+
+    Si el catalogo supera ITEM_PICKER_MAX_INLINE **no se materializa ni se
+    manda**: se devuelve vacio y el front lo busca contra /api/items/search a
+    medida que se tipea. Es el mismo criterio y el mismo umbral que ya usaba el
+    selector de /stock desde el 2026-08-13.
+
+    Por debajo del umbral el comportamiento es identico al historico: la lista
+    completa, embebida. Con el catalogo actual (299 items) no cambia nada.
+    """
+    if query is None:
+        return [], False
+    if query.order_by(None).count() > ITEM_PICKER_MAX_INLINE:
+        return [], True
+    return opciones_items(query.all(), sin_serializados), False
+
+
+def opcion_item_seleccionada(item_id):
+    """La opcion {value,text} de un item ya elegido, o None.
+
+    Con el selector remoto el <select> se renderiza vacio; sin esto, un filtro
+    vigente se veria en blanco al recargar la pagina.
+    """
+    if not item_id:
+        return None
+    raw = str(item_id).strip()
+    if not raw.isdigit():
+        return None
+    it = Item.query.get(int(raw))
+    return {"value": str(it.id), "text": f"{it.code} - {it.name}"} if it else None
+
+
+def ids_items_serializados():
+    """Ids de los items serializados. Se consulta directo en vez de derivarlo
+    de la lista de items, porque esa lista puede venir vacia en modo remoto."""
+    return [r[0] for r in db.session.query(Item.id).filter(Item.serialized.is_(True)).all()]
+
