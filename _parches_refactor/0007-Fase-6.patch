+"""Fase 6 — verificación en navegador del selector de ítems remoto.
+
+Monta un catálogo grande (por encima de ITEM_PICKER_MAX_INLINE) y comprueba en
+Chromium que /movements siga ofreciendo exactamente los mismos ítems que antes,
+pero sin volcar el catálogo en el HTML.
+
+Lo que se verifica:
+  - el HTML no trae las opciones (peso acotado, no crece con el catálogo)
+  - al elegir una ubicación interna, solo aparecen los ítems CON stock ahí
+  - al cambiar de ubicación, la lista cambia (no queda cacheada la anterior)
+  - una ubicación externa (Proveedor/Baja) ofrece cualquier ítem
+  - el tope de cantidad sigue saliendo bien
+  - cero errores de JavaScript
+
+Base sintética y temporal. No toca ningún dato real.
+"""
+import json
+import os
+import re
+import sys
+import tempfile
+import threading
+import time
+from wsgiref.simple_server import make_server
+
+N_ITEMS = int(os.environ.get("N_ITEMS", "3000"))
+
+_T = tempfile.mkdtemp(prefix="verif_items_")
+os.environ.update(
+    STOCKS_DB_PATH=os.path.join(_T, "data", "s.db"),
+    STOCKS_BACKUP_DIR=os.path.join(_T, "b"),
+    STOCKS_LOG_DIR=os.path.join(_T, "l"),
+    FLASK_SECRET_KEY="verificacion-items",
+    APP_DEBUG="false",
+    RATELIMIT_ENABLED="false",
+)
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import app as A  # noqa: E402
+
+A.app.config["WTF_CSRF_ENABLED"] = False
+FALLAS = []
+D = {}
+
+
+def chequear(cond, msg):
+    print(("  OK   " if cond else "  FALLA") + "  " + msg)
+    if not cond:
+        FALLAS.append(msg)
+
+
+def sembrar():
+    with A.app.app_context():
+        A.db.drop_all()
+        A.db.create_all()
+        A.seed_defaults()
+
+        cat = A.Category(name="Cables", prefix="CAB")
+        A.db.session.add(cat)
+        A.db.session.commit()
+
+        jaula = A.Location.query.filter_by(name=A.LOCATION_JAULA_TNG).first()
+        if not jaula:
+            jaula = A.Location(name=A.LOCATION_JAULA_TNG)
+            A.db.session.add(jaula)
+        cam_a = A.Location(name="Camioneta A", is_truck=True)
+        cam_b = A.Location(name="Camioneta B", is_truck=True)
+        A.db.session.add_all([cam_a, cam_b])
+        A.db.session.commit()
+
+        A.db.session.bulk_save_objects([
+            A.Item(code="CAB-%05d" % i, name="Cable modelo %d" % i,
+                   category_id=cat.id, is_active=True)
+            for i in range(N_ITEMS)
+        ])
+        A.db.session.commit()
+
+        its = A.Item.query.order_by(A.Item.code).all()
+        # Reparto a proposito desparejo, para poder distinguir una ubicacion de otra:
+        #   Camioneta A -> los 5 primeros    Camioneta B -> los 5 siguientes
+        #   Jaula       -> del 10 en adelante
+        filas = []
+        filas += [A.Stock(item_id=i.id, location_id=cam_a.id, quantity=7) for i in its[:5]]
+        filas += [A.Stock(item_id=i.id, location_id=cam_b.id, quantity=9) for i in its[5:10]]
+        filas += [A.Stock(item_id=i.id, location_id=jaula.id, quantity=3) for i in its[10:]]
+        A.db.session.bulk_save_objects(filas)
+        A.db.session.commit()
+
+        u = A.User(username="adm2", full_name="Admin Dos", role="ADMIN")
+        u.set_password("pass1234")
+        A.db.session.add(u)
+        A.db.session.commit()
+
+        D.update(
+            cam_a=cam_a.id, cam_b=cam_b.id, jaula=jaula.id,
+            item_a=its[0].code, item_b=its[5].code, item_jaula=its[10].code,
+            total=A.Item.query.count(),
+        )
+
+
+def opciones(pag):
+    return pag.evaluate(
+        "Object.values(document.getElementById('item_id').tomselect.options)"
+        ".map(function(o){return o.label || o.text;})")
+
+
+def elegir(pag, loc_id):
+    pag.select_option("#from_location_id", str(loc_id))
+    pag.wait_for_timeout(1200)
+
+
+def main():
+    sembrar()
+    srv = make_server("127.0.0.1", 5097, A.app)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    time.sleep(0.6)
+    base = "http://127.0.0.1:5097"
+
+    from playwright.sync_api import sync_playwright
+
+    with sync_playwright() as pw:
+        nav = pw.chromium.launch(
+            executable_path="/opt/pw-browsers/chromium-1194/chrome-linux/chrome")
+        pag = nav.new_page()
+        errores = []
+        pag.on("pageerror", lambda e: errores.append(str(e)))
+
+        pag.goto(base + "/login")
+        pag.fill('input[name="username"]', "adm2")
+        pag.fill('input[name="password"]', "pass1234")
+        pag.click('button[type="submit"], input[type="submit"]')
+        pag.wait_for_load_state("networkidle")
+
+        pag.goto(base + "/movements")
+        pag.wait_for_load_state("networkidle")
+        html = pag.content()
+
+        print("catalogo: %d items | umbral: %d\n" % (D["total"], A.ITEM_PICKER_MAX_INLINE))
+
+        # --- 1. el catalogo no viaja ---
+        isla = json.loads(re.search(
+            r'<script type="application/json" id="movements-datos">\s*(.*?)\s*</script>',
+            html, re.S).group(1))
+        remoto = D["total"] > A.ITEM_PICKER_MAX_INLINE
+        n_options = len(re.findall(r'<option value="\d+"', html))
+        chequear(isla.get("itemsRemote") is remoto,
+                 "modo remoto = %s (catalogo %d vs umbral %d)"
+                 % (remoto, D["total"], A.ITEM_PICKER_MAX_INLINE))
+        if remoto:
+            chequear(n_options < 50,
+                     "el HTML trae %d <option> (antes traia %d)" % (n_options, D["total"]))
+        else:
+            # Debajo del umbral tiene que seguir embebiendo, como siempre.
+            chequear(n_options >= D["total"],
+                     "catalogo chico: el HTML sigue trayendo las %d opciones (%d)"
+                     % (D["total"], n_options))
+
+        # --- 2. ubicacion interna: solo sus items ---
+        elegir(pag, D["cam_a"])
+        ops = opciones(pag)
+        chequear(any(o.startswith(D["item_a"]) for o in ops),
+                 "Camioneta A ofrece su item (%d opciones)" % len(ops))
+        chequear(not any(o.startswith(D["item_b"]) for o in ops),
+                 "Camioneta A NO ofrece el item de Camioneta B")
+        chequear(not any(o.startswith(D["item_jaula"]) for o in ops),
+                 "Camioneta A NO ofrece los items de la Jaula")
+        chequear(len(ops) <= 10, "Camioneta A ofrece solo sus 5 items, no el catalogo")
+
+        # --- 3. tope de cantidad ---
+        pag.evaluate(
+            "var ts = document.getElementById('item_id').tomselect;"
+            "var op = Object.values(ts.options).find(function(o){"
+            "  return (o.label || o.text).indexOf('%s') === 0; });"
+            "ts.setValue(op.id || op.value);" % D["item_a"])
+        pag.wait_for_timeout(500)
+        mx = pag.get_attribute("#qty_input", "max")
+        chequear(mx == "7", "tope de cantidad = %s (esperado 7)" % mx)
+
+        # --- 4. cambiar de ubicacion refresca de verdad ---
+        elegir(pag, D["cam_b"])
+        ops2 = opciones(pag)
+        chequear(any(o.startswith(D["item_b"]) for o in ops2),
+                 "Camioneta B ofrece su item")
+        chequear(not any(o.startswith(D["item_a"]) for o in ops2),
+                 "al cambiar de ubicacion ya NO ofrece el item de la anterior")
+
+        # --- 5. buscar por texto llega a un item lejano ---
+        elegir(pag, D["jaula"])
+        lejano = "CAB-%05d" % (D["total"] - 1)
+        pag.evaluate("document.getElementById('item_id').tomselect.load('%s')" % lejano)
+        pag.wait_for_timeout(1200)
+        chequear(any(o.startswith(lejano) for o in opciones(pag)),
+                 "buscando '%s' aparece el ultimo item del catalogo" % lejano)
+
+        chequear(not errores, "sin errores de JS (%s)" % errores)
+        nav.close()
+
+    print()
+    if FALLAS:
+        print("RESULTADO: %d FALLAS" % len(FALLAS))
+        sys.exit(1)
+    print("RESULTADO: todo OK")
+
+
+if __name__ == "__main__":
+    print("=== Fase 6 — selector de items remoto ===")
+    main()
