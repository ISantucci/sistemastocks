+"""Fase 4 — verificacion en navegador de los comportamientos data-* .
+
+Recorre las pantallas reales con Chromium, abre y cierra los modales, dispara
+los toggles y confirma que no quede ni un error de JavaScript. Es lo que el
+pytest no puede ver: pytest valida el HTML que sale del servidor, esto valida
+que el navegador siga haciendo lo mismo que antes con los handlers movidos.
+
+Base sintetica y temporal. No toca ningun dato real.
+"""
+import os
+import sys
+import tempfile
+import threading
+import time
+from wsgiref.simple_server import make_server
+
+_T = tempfile.mkdtemp(prefix="verif_ui_")
+os.environ.update(
+    STOCKS_DB_PATH=os.path.join(_T, "data", "s.db"),
+    STOCKS_BACKUP_DIR=os.path.join(_T, "b"),
+    STOCKS_LOG_DIR=os.path.join(_T, "l"),
+    FLASK_SECRET_KEY="verificacion-ui",
+    APP_DEBUG="false",
+    RATELIMIT_ENABLED="false",
+    CSP_ENFORCE=os.environ.get("CSP", "false"),
+)
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import app as A  # noqa: E402
+
+FALLAS = []
+
+
+def chequear(cond, msg):
+    print(("  OK   " if cond else "  FALLA") + "  " + msg)
+    if not cond:
+        FALLAS.append(msg)
+
+
+def sembrar():
+    with A.app.app_context():
+        A.db.drop_all()
+        A.db.create_all()
+        A.seed_defaults()
+
+        cat = A.Category(name="Cables", prefix="CAB")
+        A.db.session.add(cat)
+        A.db.session.commit()
+
+        jaula = A.Location.query.filter_by(name=A.LOCATION_JAULA_TNG).first()
+        if not jaula:
+            jaula = A.Location(name=A.LOCATION_JAULA_TNG)
+            A.db.session.add(jaula)
+        cam = A.Location(name="Camioneta A", is_truck=True)
+        A.db.session.add(cam)
+        A.db.session.commit()
+
+        for i in range(3):
+            it = A.Item(code="CAB-%03d" % i, name="Cable %d" % i,
+                        category_id=cat.id, is_active=True, stock_min=5)
+            A.db.session.add(it)
+        # Un item serializado: es el que hace aparecer el boton "Seriales" de
+        # /stock, que es el unico [data-detail-url] de esa pantalla.
+        A.db.session.add(A.Item(code="SER-001", name="Equipo con serial",
+                                category_id=cat.id, is_active=True,
+                                trackable=True, serialized=True))
+        A.db.session.commit()
+        for it in A.Item.query.all():
+            # Los rastreables solo admiten 1 unidad en todo el sistema.
+            A.upsert_stock(it.id, jaula.id, 1 if it.trackable else 2)
+        A.db.session.commit()
+
+        s = A.Supplier(contact_name="Proveedor Uno")
+        A.db.session.add(s)
+        u = A.User(username="adm2", full_name="Admin Dos", role="ADMIN")
+        u.set_password("pass1234")
+        A.db.session.add(u)
+        A.db.session.commit()
+
+
+def main():
+    sembrar()
+    srv = make_server("127.0.0.1", 5098, A.app)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    time.sleep(0.6)
+    base = "http://127.0.0.1:5098"
+
+    from playwright.sync_api import sync_playwright
+
+    with sync_playwright() as pw:
+        nav = pw.chromium.launch(
+            executable_path="/opt/pw-browsers/chromium-1194/chrome-linux/chrome")
+        pag = nav.new_page()
+        errores = []
+        pag.on("pageerror", lambda e: errores.append(str(e)))
+        # Una violacion de CSP no lanza pageerror: aparece como mensaje de consola.
+        pag.on("console", lambda m: errores.append("CSP: " + m.text)
+               if "Content Security Policy" in m.text else None)
+
+        pag.goto(base + "/login")
+        pag.fill('input[name="username"]', "adm2")
+        pag.fill('input[name="password"]', "pass1234")
+        pag.click('button[type="submit"], input[type="submit"]')
+        pag.wait_for_load_state("networkidle")
+
+        # --- 1. todas las pantallas cargan sin error de JS ---
+        rutas = ["/", "/items", "/stock", "/movements", "/movements/bulk",
+                 "/item-usage", "/remitos", "/scrap", "/reparaciones",
+                 "/pending-deliveries", "/stock-alerts", "/solicitudes-compra",
+                 "/solicitudes-repuestos", "/ingresos-egresos", "/proveedores",
+                 "/users", "/locations", "/categories", "/conteo", "/admin",
+                 "/metricas", "/metricas/compras", "/metricas/inventario", "/perfil"]
+        for r in rutas:
+            del errores[:]
+            resp = pag.goto(base + r)
+            pag.wait_for_load_state("networkidle")
+            chequear(resp.status == 200 and not errores,
+                     "carga %-24s status=%s js=%s" % (r, resp.status, errores or "limpio"))
+
+        # --- 2. los modales abren y cierran por data-* ---
+        casos = [
+            ("/items", "[data-modal-open]", "modal-item-new"),
+            ("/categories", "[data-modal-open]", "modal-cat-new"),
+            ("/locations", "[data-modal-open]", "modal-loc-new"),
+            ("/solicitudes-compra", "[data-modal-open]", "modal-sc-new"),
+        ]
+        for ruta, sel, modal_id in casos:
+            del errores[:]
+            pag.goto(base + ruta)
+            pag.wait_for_load_state("networkidle")
+            btn = pag.query_selector(sel)
+            if not btn:
+                chequear(False, "%s: no hay boton [data-modal-open]" % ruta)
+                continue
+            btn.click()
+            pag.wait_for_timeout(250)
+            abierto = pag.evaluate(
+                "(function(id){var m=document.getElementById(id);"
+                "return !!m && (m.classList.contains('open') ||"
+                " getComputedStyle(m).display !== 'none');})('%s')" % modal_id)
+            chequear(abierto, "%s: abre el modal %s" % (ruta, modal_id))
+
+            cerrar = pag.query_selector('[data-modal-close="%s"]' % modal_id)
+            if cerrar:
+                cerrar.click()
+                pag.wait_for_timeout(250)
+                cerrado = pag.evaluate(
+                    "(function(id){var m=document.getElementById(id);"
+                    "return !!m && !m.classList.contains('open') &&"
+                    " getComputedStyle(m).display === 'none';})('%s')" % modal_id)
+                chequear(cerrado, "%s: cierra el modal %s" % (ruta, modal_id))
+            chequear(not errores, "%s: sin errores de JS (%s)" % (ruta, errores))
+
+        # --- 3. el panel de detalle (iframe) abre por data-detail-url ---
+        del errores[:]
+        pag.goto(base + "/stock")
+        pag.wait_for_load_state("networkidle")
+        det = pag.query_selector("[data-detail-url]")
+        if det:
+            det.click()
+            pag.wait_for_timeout(600)
+            abierto = pag.evaluate(
+                "(function(){var m=document.getElementById('detail-modal');"
+                "return !!m && m.classList.contains('open');})()")
+            chequear(abierto, "/stock: abre el panel de detalle")
+            pag.keyboard.press("Escape")
+            pag.wait_for_timeout(400)
+            chequear(pag.evaluate(
+                "(function(){var m=document.getElementById('detail-modal');"
+                "return !!m && !m.classList.contains('open');})()"),
+                "/stock: Escape cierra el panel de detalle")
+        else:
+            chequear(False, "/stock: no hay [data-detail-url]")
+        chequear(not errores, "/stock: sin errores de JS (%s)" % errores)
+
+        # --- 4. data-confirm: cancelar NO envia el formulario ---
+        del errores[:]
+        pag.goto(base + "/admin")
+        pag.wait_for_load_state("networkidle")
+        pag.on("dialog", lambda d: d.dismiss())
+        f = pag.query_selector("form[data-confirm]")
+        if f:
+            url_antes = pag.url
+            btn = f.query_selector('button[type="submit"], input[type="submit"], button')
+            if btn:
+                btn.click()
+                pag.wait_for_timeout(500)
+                chequear(pag.url == url_antes,
+                         "/admin: cancelar el confirm NO envia el formulario")
+        else:
+            chequear(False, "/admin: no hay form[data-confirm]")
+
+        # --- 5. no debe quedar JS inline ejecutable en el HTML servido ---
+        del errores[:]
+        for r in ["/", "/items", "/stock", "/users", "/categories", "/locations",
+                  "/admin", "/proveedores", "/conteo"]:
+            pag.goto(base + r)
+            html = pag.content()
+            import re as _re
+            inline = _re.findall(r"<script(?![^>]*\bsrc=)(?![^>]*application/json)[^>]*>",
+                                 html)
+            handlers = _re.findall(r'\son(?:click|change|submit)="', html)
+            chequear(not inline and not handlers,
+                     "%-14s sin JS inline (scripts=%d handlers=%d)"
+                     % (r, len(inline), len(handlers)))
+
+        # --- 6. los graficos de metricas se dibujan de verdad ---
+        for r in ["/metricas", "/metricas/compras", "/metricas/inventario",
+                  "/metricas/descartes"]:
+            del errores[:]
+            pag.goto(base + r)
+            pag.wait_for_load_state("networkidle")
+            pag.wait_for_timeout(700)
+            # Cada grafico declarado en la isla tiene que haber sido PROCESADO:
+            # o quedo un <canvas> con un Chart dibujado, o MX lo reemplazo por el
+            # cartel "Sin datos". Lo que no puede pasar es que quede el canvas
+            # vacio y sin Chart: eso significa que el JS no corrio.
+            resultado = pag.evaluate("""
+                (function () {
+                  var isla = document.getElementById('metricas-graficos');
+                  if (!isla) return {declarados: 0, resueltos: 0};
+                  var defs = JSON.parse(isla.textContent);
+                  var ok = 0;
+                  defs.forEach(function (d) {
+                    var c = document.getElementById(d.canvas);
+                    if (!c) { ok++; return; }              // reemplazado por "Sin datos"
+                    if (window.Chart && Chart.getChart && Chart.getChart(c)) ok++;
+                  });
+                  return {declarados: defs.length, resueltos: ok};
+                })()
+            """)
+            chequear(resultado["declarados"] > 0
+                     and resultado["resueltos"] == resultado["declarados"],
+                     "%-22s resuelve %d/%d graficos %s"
+                     % (r, resultado["resueltos"], resultado["declarados"], errores or ""))
+
+        nav.close()
+
+    print()
+    if FALLAS:
+        print("RESULTADO: %d FALLAS" % len(FALLAS))
+        sys.exit(1)
+    print("RESULTADO: todo OK")
+
+
+if __name__ == "__main__":
+    print("=== Verificacion de UI en navegador (Fase 4) ===")
+    main()
