diff --git a/tests/test_items_remoto.py b/tests/test_items_remoto.py
new file mode 100644
index 0000000..19b12ec
--- /dev/null
+++ b/tests/test_items_remoto.py
@@ -0,0 +1,212 @@
+"""Fase 6 — el catálogo de ítems deja de viajar dentro del HTML.
+
+Antes de esta fase, `/movements`, `/movements/bulk`, `/item-usage`, `/scrap` e
+`/ingresos-egresos` volcaban el catálogo COMPLETO en `<option>` y el JavaScript
+descartaba en el navegador los ítems sin stock en el origen elegido. Medido: con
+25.000 ítems eran ~5 MB de HTML por pantalla, en cada request, para terminar
+mostrando unas pocas opciones.
+
+Ahora, por encima de ITEM_PICKER_MAX_INLINE, el servidor no manda ninguna opción
+y el filtrado ocurre donde están los datos.
+
+Lo que estos tests cuidan:
+  - por debajo del umbral NO cambia nada (compatibilidad con el volumen actual)
+  - por encima, el HTML deja de crecer con el catálogo
+  - la API acota por ubicación igual que lo hacía el JS
+  - y respeta el alcance del TÉCNICO, que es lo que no se puede perder
+"""
+import re
+
+import pytest
+from conftest import make_user, make_item, make_location, login
+
+PANTALLAS = ["/movements", "/movements/bulk", "/item-usage", "/scrap", "/ingresos-egresos"]
+
+
+@pytest.fixture()
+def esc(A):
+    A.app.config["WTF_CSRF_ENABLED"] = False
+
+    tec = make_user(A, "tec", "TECNICO")
+    make_user(A, "adm2", "ADMIN")
+
+    jaula = make_location(A, A.LOCATION_JAULA_TNG)
+    make_location(A, A.LOCATION_PROVEEDOR, is_external=True)
+    mi_cam = make_location(A, "Camioneta Mia", is_truck=True)
+    otra = make_location(A, "Camioneta Ajena", is_truck=True)
+
+    A.db.session.add(A.LocationResponsible(location_id=mi_cam.id, user_id=tec.id))
+    A.db.session.commit()
+
+    it_mio = make_item(A, code="MIO-001", name="Item mio")
+    it_ajeno = make_item(A, code="AJE-001", name="Item ajeno")
+    it_jaula = make_item(A, code="JAU-001", name="Item de jaula")
+    it_sin = make_item(A, code="SIN-001", name="Item sin stock")
+
+    A.upsert_stock(it_mio.id, mi_cam.id, 7)
+    A.upsert_stock(it_ajeno.id, otra.id, 9)
+    A.upsert_stock(it_jaula.id, jaula.id, 100)
+    A.db.session.commit()
+
+    return {"tec": tec, "jaula": jaula, "mi_cam": mi_cam, "otra": otra,
+            "it_mio": it_mio, "it_ajeno": it_ajeno, "it_jaula": it_jaula,
+            "it_sin": it_sin,
+            "proveedor": A.Location.query.filter_by(name=A.LOCATION_PROVEEDOR).first()}
+
+
+def _como(A, username):
+    c = A.app.test_client()
+    login(c, username)
+    return c
+
+
+@pytest.fixture()
+def umbral(A):
+    original = A.ITEM_PICKER_MAX_INLINE
+    yield lambda v: setattr(A, "ITEM_PICKER_MAX_INLINE", v)
+    A.ITEM_PICKER_MAX_INLINE = original
+
+
+def _n_options(html):
+    return len(re.findall(r'<option value="\d+"', html))
+
+
+def _sembrar_catalogo(A, n, prefijo="MASA"):
+    cat = A.Category.query.first()
+    A.db.session.bulk_save_objects([
+        A.Item(code=f"{prefijo}-{i:05d}", name=f"Item masivo {i}",
+               category_id=cat.id, is_active=True)
+        for i in range(n)
+    ])
+    A.db.session.commit()
+
+
+# --------------------------------------------------- compatibilidad (hoy)
+
+@pytest.mark.parametrize("ruta", PANTALLAS)
+def test_catalogo_chico_sigue_embebido(A, esc, umbral, ruta):
+    """Con el volumen actual (299 items) no debe cambiar absolutamente nada."""
+    umbral(800)
+    html = _como(A, "adm2").get(ruta).get_data(as_text=True)
+    assert _n_options(html) > 0, f"{ruta} dejo de embeber opciones sin superar el umbral"
+
+
+def test_umbral_por_defecto_es_el_de_siempre(A):
+    """El umbral se comparte con el selector de /stock desde el 2026-08-13."""
+    assert A.ITEM_PICKER_MAX_INLINE >= 800
+
+
+# ------------------------------------------------------------ modo remoto
+
+@pytest.mark.parametrize("ruta", PANTALLAS)
+def test_catalogo_grande_no_viaja_en_el_html(A, esc, umbral, ruta):
+    umbral(0)
+    _sembrar_catalogo(A, 200)
+    html = _como(A, "adm2").get(ruta).get_data(as_text=True)
+    assert _n_options(html) < 30, (
+        f"{ruta} sigue mandando {_n_options(html)} opciones con el modo remoto activo"
+    )
+
+
+@pytest.mark.parametrize("ruta", PANTALLAS)
+def test_el_html_no_crece_con_el_catalogo(A, esc, umbral, ruta):
+    """La prueba de fondo: mas items no debe pesar mas HTML."""
+    umbral(0)
+    c = _como(A, "adm2")
+    antes = len(c.get(ruta).get_data())
+    _sembrar_catalogo(A, 500)
+    despues = len(c.get(ruta).get_data())
+    assert despues - antes < 5_000, (
+        f"{ruta} crecio {despues - antes} bytes al agregar 500 items"
+    )
+
+
+def test_en_modo_embebido_el_html_si_crece(A, esc, umbral):
+    """Contraprueba: sin modo remoto el problema existe. Evita un falso verde."""
+    umbral(999_999)
+    c = _como(A, "adm2")
+    antes = len(c.get("/movements").get_data())
+    _sembrar_catalogo(A, 500)
+    assert len(c.get("/movements").get_data()) - antes > 20_000
+
+
+# ------------------------------------------- la API acota por ubicacion
+
+def _codigos(resp):
+    return {f["code"] for f in resp.get_json()}
+
+
+def test_api_acota_por_ubicacion_interna(A, esc):
+    """Debe devolver solo lo que TIENE stock ahi: es el filtro que hacia el JS."""
+    c = _como(A, "adm2")
+    cods = _codigos(c.get(f"/api/items/search?location_id={esc['mi_cam'].id}"))
+    assert "MIO-001" in cods
+    assert "AJE-001" not in cods
+    assert "JAU-001" not in cods
+    assert "SIN-001" not in cods
+
+
+def test_api_no_acota_en_ubicacion_externa(A, esc):
+    """Proveedor/Baja no tienen stock propio: admiten cualquier item."""
+    cods = _codigos(_como(A, "adm2").get(
+        f"/api/items/search?location_id={esc['proveedor'].id}"))
+    assert {"MIO-001", "AJE-001", "JAU-001", "SIN-001"} <= cods
+
+
+def test_api_sin_ubicacion_devuelve_todo(A, esc):
+    cods = _codigos(_como(A, "adm2").get("/api/items/search"))
+    assert "SIN-001" in cods
+
+
+@pytest.mark.parametrize("valor", ["", "abc", "-1", "999999", "1;DROP TABLE items"])
+def test_api_tolera_basura_en_location_id(A, esc, valor):
+    r = _como(A, "adm2").get("/api/items/search", query_string={"location_id": valor})
+    assert r.status_code == 200
+    assert isinstance(r.get_json(), list)
+
+
+def test_api_respeta_el_limite(A, esc, umbral):
+    _sembrar_catalogo(A, 300)
+    r = _como(A, "adm2").get("/api/items/search")
+    assert len(r.get_json()) <= A.ITEM_SEARCH_LIMIT
+
+
+# ------------------------------------- el alcance del TECNICO no se pierde
+
+def test_tecnico_no_ve_items_de_ubicacion_ajena_por_la_api(A, esc):
+    """Lo importante de la fase: acotar el HTML no puede abrir la API."""
+    cods = _codigos(_como(A, "tec").get(
+        f"/api/items/search?location_id={esc['otra'].id}"))
+    assert "AJE-001" not in cods
+
+
+def test_tecnico_si_ve_los_suyos(A, esc):
+    cods = _codigos(_como(A, "tec").get(
+        f"/api/items/search?location_id={esc['mi_cam'].id}"))
+    assert "MIO-001" in cods
+
+
+def test_tecnico_no_ve_el_catalogo_completo_ni_sin_ubicacion(A, esc):
+    """Sin location_id sigue mandando items_visible_query(), que ya lo acota."""
+    cods = _codigos(_como(A, "tec").get("/api/items/search"))
+    assert "MIO-001" in cods
+    assert "AJE-001" not in cods
+    assert "JAU-001" not in cods
+
+
+def test_tecnico_no_puede_usar_una_externa_para_ver_todo(A, esc):
+    """Una ubicacion externa no filtra por stock, pero el alcance del rol sigue."""
+    cods = _codigos(_como(A, "tec").get(
+        f"/api/items/search?location_id={esc['proveedor'].id}"))
+    assert "AJE-001" not in cods
+    assert "JAU-001" not in cods
+
+
+# ------------------------------------------------ el filtro sigue visible
+
+def test_el_filtro_aplicado_se_sigue_viendo_en_modo_remoto(A, esc, umbral):
+    """Con el select vacio, un filtro vigente quedaria en blanco al recargar."""
+    umbral(0)
+    html = _como(A, "adm2").get(
+        f"/movements?item_id={esc['it_jaula'].id}").get_data(as_text=True)
+    assert "JAU-001" in html, "se perdio el item elegido en el filtro"
