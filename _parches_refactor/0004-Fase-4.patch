+      out.textContent = "Copiado.";
+      setTimeout(function () { out.textContent = ""; }, 2000);
+    }
+  });
+})();
diff --git a/static/js/remitos.js b/static/js/remitos.js
new file mode 100644
index 0000000..84bc9c1
--- /dev/null
+++ b/static/js/remitos.js
@@ -0,0 +1,87 @@
+/* Pantalla: Remitos
+ *
+ * Movido desde el <script> inline del template en la Fase 4. Misma logica;
+ * los datos ahora vienen de la isla JSON #remitos-datos en vez de interpolarse con
+ * Jinja adentro del codigo.
+ */
+var D = leerDatos("remitos-datos");
+  var REMITO_MOVS_URL = D.movsUrl || "/remitos/movimientos";
+  var REMITO_RESP_URL = D.respUrl || "/remitos/responsables";
+
+  function openRemitoModal() { openModal('modal-remito-new'); }
+
+  function onLocChange(which) {
+    loadResponsables(which);
+    loadRemitoMovs();
+  }
+
+  function loadResponsables(which) {
+    var locSel = document.getElementById(which === 'from' ? 'rm-from' : 'rm-to');
+    var respSel = document.getElementById(which === 'from' ? 'rm-resp-from' : 'rm-resp-to');
+    var loc = locSel.value;
+    respSel.disabled = false;
+    respSel.innerHTML = '<option value="">Cargando...</option>';
+    if (!loc) { respSel.innerHTML = '<option value="" disabled selected>Elegí la ubicación...</option>'; return; }
+    fetch(REMITO_RESP_URL + '?location_id=' + encodeURIComponent(loc))
+      .then(function (r) { return r.json(); })
+      .then(function (data) {
+        if (data.external) {
+          respSel.innerHTML = '<option value="">Proveedor — se completa a mano</option>';
+          respSel.disabled = true;
+          return;
+        }
+        var opts = data.responsibles || [];
+        if (opts.length === 0) {
+          respSel.innerHTML = '<option value="" disabled selected>Sin responsables cargados</option>';
+          return;
+        }
+        var html = '';
+        if (opts.length > 1) { html += '<option value="" disabled selected>Elegí responsable...</option>'; }
+        opts.forEach(function (o) { html += '<option value="' + o.id + '">' + o.name + '</option>'; });
+        respSel.innerHTML = html;
+        if (opts.length === 1) { respSel.value = String(opts[0].id); }
+      })
+      .catch(function () { respSel.innerHTML = '<option value="" disabled selected>Error al cargar</option>'; });
+  }
+
+  function loadRemitoMovs() {
+    var from = document.getElementById('rm-from').value;
+    var to = document.getElementById('rm-to').value;
+    var dFrom = document.getElementById('rm-date-from').value;
+    var dTo = document.getElementById('rm-date-to').value;
+    var body = document.getElementById('rm-mov-body');
+    var chkAll = document.getElementById('rm-check-all');
+    if (chkAll) chkAll.checked = false;
+    if (!from || !to) return;
+    body.innerHTML = '<tr><td colspan="6" class="muted">Cargando...</td></tr>';
+    fetch(REMITO_MOVS_URL + '?from_location_id=' + encodeURIComponent(from) + '&to_location_id=' + encodeURIComponent(to)
+          + '&date_from=' + encodeURIComponent(dFrom) + '&date_to=' + encodeURIComponent(dTo))
+      .then(function (r) { return r.text(); })
+      .then(function (html) { body.innerHTML = html; })
+      .catch(function () { body.innerHTML = '<tr><td colspan="6" class="muted">No se pudieron cargar los movimientos.</td></tr>'; });
+  }
+
+  function toggleAllRemitoMovs(master) {
+    document.querySelectorAll('#rm-mov-body input[name="movement_id"]').forEach(function (c) {
+      c.checked = master.checked;
+    });
+  }
+
+/* Enganche de los controles de la pantalla.
+ *
+ * Antes cada <select> traia su onchange="onLocChange('from')" escrito en el
+ * HTML. Ahora el HTML solo declara el atributo y el enganche vive aca, por
+ * delegacion (asi sirve tambien para el contenido que se recarga por fetch).
+ */
+document.addEventListener("change", function (e) {
+  var el = e.target.closest ? e.target.closest("[data-remito-loc]") : null;
+  if (el) { onLocChange(el.getAttribute("data-remito-loc")); return; }
+
+  el = e.target.closest ? e.target.closest("[data-remito-reload]") : null;
+  if (el) { loadRemitoMovs(); }
+});
+
+document.addEventListener("click", function (e) {
+  var el = e.target.closest ? e.target.closest("[data-remito-toggle-all]") : null;
+  if (el) toggleAllRemitoMovs(el);
+});
diff --git a/static/js/repair_request_detail.js b/static/js/repair_request_detail.js
new file mode 100644
index 0000000..c909893
--- /dev/null
+++ b/static/js/repair_request_detail.js
@@ -0,0 +1,25 @@
+/* Pantalla: Detalle de solicitud de repuestos
+ *
+ * Movido tal cual desde el <script> inline del template en la Fase 4.
+ * No tenia datos interpolados con Jinja, asi que la logica no cambio en
+ * nada: solo dejo de ir inline para que la CSP pueda cerrarse.
+ */
+// Limita la selección de seriales por línea a la cantidad pedida.
+document.addEventListener("DOMContentLoaded", function () {
+  document.querySelectorAll('input[type="checkbox"][data-line]:not(.rr-pending-flag)').forEach(function (cb) {
+    cb.addEventListener("change", function () {
+      var line = cb.getAttribute("data-line");
+      var max = parseInt(cb.getAttribute("data-max"), 10) || 0;
+      var checked = document.querySelectorAll('input[data-line="' + line + '"]:not(.rr-pending-flag):checked');
+      if (checked.length > max) { cb.checked = false; }
+    });
+  });
+  // Mostrar/ocultar el detalle del pendiente por línea.
+  document.querySelectorAll(".rr-pending-flag").forEach(function (flag) {
+    flag.addEventListener("change", function () {
+      var line = flag.getAttribute("data-line");
+      var box = document.querySelector('.rr-pending-box[data-line="' + line + '"]');
+      if (box) box.style.display = flag.checked ? "block" : "none";
+    });
+  });
+});
diff --git a/static/js/repair_requests.js b/static/js/repair_requests.js
new file mode 100644
index 0000000..9c87627
--- /dev/null
+++ b/static/js/repair_requests.js
@@ -0,0 +1,32 @@
+/* Pantalla: Solicitudes de repuestos
+ *
+ * Movido tal cual desde el <script> inline del template en la Fase 4.
+ * No tenia datos interpolados con Jinja, asi que la logica no cambio en
+ * nada: solo dejo de ir inline para que la CSP pueda cerrarse.
+ */
+document.addEventListener("DOMContentLoaded", function () {
+  function wireLine(line) {
+    var rm = line.querySelector(".remove-line-btn");
+    if (rm) rm.addEventListener("click", function () { line.remove(); });
+    // Selector de repuesto buscable/tipeable (las lineas se clonan, el init
+    // global de TomSelect no las alcanza, asi que lo inicializamos por linea).
+    var sel = line.querySelector('select[name="item_id[]"]');
+    if (sel && window.TomSelect && !sel.tomselect) {
+      new TomSelect(sel, window.TS_SINGLE_OPTS);
+    }
+  }
+  function addLine() {
+    var tpl = document.getElementById("rr-line-template");
+    var cont = document.getElementById("rr-lines");
+    cont.appendChild(tpl.content.cloneNode(true));
+    wireLine(cont.lastElementChild);
+  }
+  // El formulario de alta solo existe para el rol que puede crear solicitudes.
+  // Antes este script vivia dentro del condicional del
+  // template, asi que nunca corria para los demas roles; ahora el archivo se
+  // carga siempre y hay que chequear.
+  var btnAdd = document.getElementById("add-line-btn");
+  if (!btnAdd) return;
+  btnAdd.addEventListener("click", addLine);
+  addLine();
+});
diff --git a/static/js/scrap_report.js b/static/js/scrap_report.js
new file mode 100644
index 0000000..c7416f1
--- /dev/null
+++ b/static/js/scrap_report.js
@@ -0,0 +1,118 @@
+/* Pantalla: Descartes
+ *
+ * Movido desde el <script> inline del template en la Fase 4. Misma logica;
+ * los datos ahora vienen de la isla JSON #scrap-datos en vez de interpolarse con
+ * Jinja adentro del codigo.
+ */
+document.addEventListener("DOMContentLoaded", function () {
+  // Filtros: en desktop siempre visibles; en mobile colapsados por defecto.
+  var scrapFilters = document.getElementById("scrapFilters");
+  if (scrapFilters) {
+    var syncScrapFilters = function () {
+      if (window.matchMedia("(min-width:768px)").matches) { scrapFilters.open = true; }
+    };
+    syncScrapFilters();
+    window.addEventListener("resize", syncScrapFilters);
+  }
+  var D = leerDatos("scrap-datos");
+  var stockMap = D.stockMap || {};
+  var stockQtyMap = D.stockQtyMap || {};
+  // Fase 2: si el servidor decidio no embeber el mapa (inventario grande),
+  // ensureStock() lo pide por ubicacion antes de usarlo. Con el mapa embebido
+  // es un passthrough sincronico y el flujo es identico al historico.
+  //
+  // Se construye PEREZOSAMENTE a proposito: en algunas pantallas este bloque
+  // corre dentro del bloque de contenido, es decir ANTES de que base.html
+  // cargue app.js al final del body. Llamarlo aca arriba reventaba
+  // con "makeStockLoader is not defined". Difiriendolo al primer uso (que
+  // siempre ocurre despues de un evento del usuario o del DOMContentLoaded) el
+  // orden de carga deja de importar.
+  var STOCK_REMOTE = !!D.stockRemote;
+  var _stockLoader = null;
+  function ensureStock(locId, cb) {
+    if (!_stockLoader) {
+      _stockLoader = makeStockLoader(stockMap, stockQtyMap, STOCK_REMOTE);
+    }
+    return _stockLoader(locId, cb);
+  }
+  var fromSel = document.getElementById("from_location_id");
+
+  // Lista de ítems seleccionables (excluye serializados: van por Movimientos).
+  var allScrapItems = D.items || [];
+
+  function allowedForCurrentFrom() {
+    var locId = fromSel ? String(fromSel.value || "") : "";
+    var allowed = stockMap[locId] || [];
+    var set = {};
+    allowed.forEach(function (id) { set[String(id)] = true; });
+    return { locId: locId, set: set };
+  }
+
+  function clampScrapQty(line) {
+    if (!line) return;
+    var loc = fromSel ? String(fromSel.value || "") : "";
+    var itemSel = line.querySelector(".scrap-item");
+    var item = itemSel ? String(itemSel.value || "") : "";
+    var qty = line.querySelector('input[name="qty[]"]');
+    if (!qty) return;
+    if (!loc || !item) { qty.removeAttribute("max"); return; }
+    var mx = (stockQtyMap[loc] || {})[item];
+    if (mx == null) { qty.removeAttribute("max"); return; }
+    qty.setAttribute("max", mx);
+    var v = parseInt(qty.value, 10);
+    if (!isNaN(v) && v > mx) { qty.value = mx; }
+  }
+
+  function applyStockFilterToLine(el) {
+    if (!el || !el.tomselect) return;
+    var ts = el.tomselect;
+    var info = allowedForCurrentFrom();
+    ts.clear(true);
+    ts.clearOptions();
+    allScrapItems.forEach(function (o) { if (info.set[o.value]) ts.addOption(o); });
+    ts.refreshOptions(false);
+    if (!info.locId) { ts.disable(); } else { ts.enable(); }
+  }
+
+  function applyStockFilterAllLines() {
+    document.querySelectorAll(".scrap-item").forEach(applyStockFilterToLine);
+  }
+
+  function initTomSelectFor(el) {
+    if (!el || el.tomselect) return;
+    new TomSelect(el, {
+      create: false,
+      sortField: { field: "text", direction: "asc" },
+      placeholder: "Elegí la ubicación de origen primero...",
+      closeAfterSelect: true,
+      onItemAdd: function () { this.setTextboxValue(''); this.blur(); },
+      onChange: function () { this.blur(); clampScrapQty(el.closest(".scrap-line")); }
+    });
+    applyStockFilterToLine(el);
+  }
+
+  function wireScrapLine(line) {
+    var itemSelect = line.querySelector(".scrap-item");
+    var removeBtn = line.querySelector(".remove-line-btn");
+    initTomSelectFor(itemSelect);
+    var qtyEl = line.querySelector('input[name="qty[]"]');
+    if (qtyEl) { qtyEl.addEventListener("input", function () { clampScrapQty(line); }); }
+    if (removeBtn) { removeBtn.addEventListener("click", function () { line.remove(); }); }
+  }
+
+  function addScrapLine() {
+    var tpl = document.getElementById("scrap-line-template");
+    var container = document.getElementById("scrap-lines");
+    container.appendChild(tpl.content.cloneNode(true));
+    wireScrapLine(container.lastElementChild);
+  }
+
+  document.getElementById("add-line-btn").addEventListener("click", addScrapLine);
+  addScrapLine();
+
+  if (fromSel && fromSel.tagName === "SELECT") {
+    fromSel.addEventListener("change", function () {
+      ensureStock(fromSel.value, applyStockFilterAllLines);
+    });
+  }
+});
diff --git a/static/js/ui.js b/static/js/ui.js
new file mode 100644
index 0000000..79f52ba
--- /dev/null
+++ b/static/js/ui.js
@@ -0,0 +1,138 @@
+/* Comportamientos de UI declarativos, por delegacion de eventos.
+ *
+ * Por que existe este archivo (Fase 4):
+ * antes cada boton traia su propio `onclick="openModal('x')"` escrito en el
+ * HTML. Eso son ~70 handlers inline repartidos en 20 templates. Dos problemas:
+ *
+ *   1. Obligan a mantener 'unsafe-inline' en la CSP, que es justo la directiva
+ *      que hace que una CSP sirva de poco. Sin handlers inline la politica se
+ *      puede cerrar de verdad.
+ *   2. No se pueden testear ni linter-ear, y se duplican en cada template.
+ *
+ * Ahora el HTML solo declara QUE quiere (data-modal-open="x") y el
+ * comportamiento vive aca, una sola vez, enganchado por delegacion en document.
+ * Al ser delegado funciona tambien para nodos agregados despues (filas nuevas,
+ * lineas de un formulario dinamico), sin re-enganchar nada.
+ *
+ * Atributos soportados:
+ *   data-modal-open="id"     abre el modal
+ *   data-modal-close="id"    lo cierra
+ *   data-detail-url="url"    abre el panel de detalle con esa url
+ *   data-detail             (en un <a>) abre el detalle con su propio href
+ *   data-detail-dismiss      cierra el panel de detalle
+ *   data-toggle="id"         alterna display none/block de ese elemento
+ *   data-print               window.print()
+ *   data-toggle-pw="id"      alterna mostrar/ocultar de un input de contrasena
+ *   data-select-all          selecciona todo el texto del input al hacer clic
+ *   data-submit-on-change    envia el formulario al cambiar (selects de filtro)
+ *   data-confirm="texto"     (en un <form>) pide confirmacion antes de enviar
+ */
+(function () {
+  "use strict";
+
+  function cerca(destino, attr) {
+    return destino && destino.closest ? destino.closest("[" + attr + "]") : null;
+  }
+
+  document.addEventListener("click", function (e) {
+    var el;
+
+    el = cerca(e.target, "data-modal-open");
+    if (el) { openModal(el.getAttribute("data-modal-open")); return; }
+
+    el = cerca(e.target, "data-modal-close");
+    if (el) { closeModal(el.getAttribute("data-modal-close")); return; }
+
+    el = cerca(e.target, "data-detail-url");
+    if (el && typeof openDetail === "function") {
+      e.preventDefault();
+      openDetail(el.getAttribute("data-detail-url"));
+      return;
+    }
+
+    el = cerca(e.target, "data-detail");
+    if (el && el.href && typeof openDetail === "function") {
+      e.preventDefault();
+      openDetail(el.href);
+      return;
+    }
+
+    el = cerca(e.target, "data-detail-dismiss");
+    if (el && typeof dismissDetail === "function") { dismissDetail(); return; }
+
+    el = cerca(e.target, "data-toggle");
+    if (el) {
+      var obj = document.getElementById(el.getAttribute("data-toggle"));
+      if (obj) obj.style.display = (obj.style.display === "none" || !obj.style.display)
+        ? "block" : "none";
+      return;
+    }
+
+    el = cerca(e.target, "data-print");
+    if (el) { window.print(); return; }
+
+    el = cerca(e.target, "data-toggle-pw");
+    if (el && typeof togglePw === "function") {
+      togglePw(el.getAttribute("data-toggle-pw"), el);
+      return;
+    }
+
+    if (e.target && e.target.hasAttribute && e.target.hasAttribute("data-select-all")) {
+      if (e.target.select) e.target.select();
+    }
+  });
+
+  document.addEventListener("change", function (e) {
+    var el = cerca(e.target, "data-submit-on-change");
+    if (el && el.form) el.form.submit();
+  });
+
+  // Confirmacion antes de enviar. Se hace en 'submit' y no en el click del boton
+  // para que tambien cubra el Enter dentro del formulario.
+  document.addEventListener("submit", function (e) {
+    var f = e.target;
+    if (!f || !f.hasAttribute || !f.hasAttribute("data-confirm")) return;
+    if (!window.confirm(f.getAttribute("data-confirm"))) {
+      e.preventDefault();
+    }
+  });
+})();
+
+/* ---------- Bloques que aparecen segun un radio (data-show-when) ----------
+ *
+ * Reemplaza los <script> que iban DENTRO del bucle de filas en Pendientes y
+ * Reparaciones: uno por fila, con el id interpolado por Jinja. Con 40 filas eso
+ * eran 40 scripts inline identicos salvo el numero.
+ *
+ * Ahora el bloque declara cuando quiere mostrarse:
+ *   <div data-show-when="return_action=scrap">
+ * y se resuelve contra el radio de ESE mismo formulario, asi que sirve igual
+ * para una fila que para cien.
+ */
+(function () {
+  "use strict";
+
+  function aplicar(form) {
+    if (!form) return;
+    form.querySelectorAll("[data-show-when]").forEach(function (bloque) {
+      var partes = (bloque.getAttribute("data-show-when") || "").split("=");
+      var campo = partes[0];
+      var valor = partes.slice(1).join("=");
+      if (!campo) return;
+      var marcado = form.querySelector('input[name="' + campo + '"]:checked');
+      bloque.style.display = (marcado && marcado.value === valor) ? "block" : "none";
+    });
+  }
+
+  document.addEventListener("change", function (e) {
+    if (!e.target || e.target.type !== "radio") return;
+    var form = e.target.form || (e.target.closest && e.target.closest("form"));
+    if (form && form.querySelector("[data-show-when]")) aplicar(form);
+  });
+
+  document.addEventListener("DOMContentLoaded", function () {
+    document.querySelectorAll("[data-show-when]").forEach(function (b) {
+      aplicar(b.form || (b.closest && b.closest("form")));
+    });
+  });
+})();
