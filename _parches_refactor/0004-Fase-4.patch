diff --git a/tests/conftest.py b/tests/conftest.py
index d808b46..d7d5a4c 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -99,3 +99,45 @@ def csrf_from(client, path):
     html = client.get(path).get_data(as_text=True)
     m = re.search(r'name="csrf_token" value="([^"]+)"', html)
     return m.group(1) if m else None
+
+
+# ------------------ helpers de lectura del HTML ------------------
+
+def datos_de_pantalla(html, isla=None):
+    """Datos que el servidor le pasa al JS de una pantalla.
+
+    Desde la Fase 4 viajan en una isla JSON
+    (<script type="application/json" id="...-datos">) en vez de interpolarse
+    dentro del codigo. Esta funcion acepta las dos formas para que un test no
+    dependa del envoltorio, solo del contenido.
+    """
+    import json as _json
+
+    if isla:
+        m = re.search(
+            r'<script type="application/json" id="%s">\s*(.*?)\s*</script>' % isla,
+            html, re.S)
+        if m:
+            return _json.loads(m.group(1))
+
+    m = re.search(r'<script type="application/json" id="[\w-]+-datos">\s*(.*?)\s*</script>',
+                  html, re.S)
+    if m:
+        return _json.loads(m.group(1))
+    return None
+
+
+def var_js(html, nombre):
+    """Valor de una variable del JS de la pantalla.
+
+    Busca primero en la isla JSON (nombre en camelCase, tal como lo publica el
+    template) y si no esta, cae al viejo `var nombre = ...;` inline.
+    """
+    import json as _json
+
+    d = datos_de_pantalla(html)
+    if d is not None and nombre in d:
+        return d[nombre]
+
+    m = re.search(r"var %s = (.*?);\n" % nombre, html, re.S)
+    return _json.loads(m.group(1)) if m else None
diff --git a/tests/test_csp_sin_js_inline.py b/tests/test_csp_sin_js_inline.py
new file mode 100644
index 0000000..5ac9c55
--- /dev/null
+++ b/tests/test_csp_sin_js_inline.py
@@ -0,0 +1,93 @@
+"""Guarda de la Fase 4: que no vuelva el JavaScript inline.
+
+Por que existe: sacar las 928 lineas de JS inline y los ~70 handlers `onclick=`
+fue lo que permitio quitar 'unsafe-inline' de script-src. Si alguien vuelve a
+escribir un <script> con codigo adentro de un template, la CSP lo bloquea en
+produccion y la pantalla se rompe **en silencio** (no hay error de servidor,
+solo deja de andar el JS).
+
+Estos tests fallan en el momento de escribirlo, no seis meses despues.
+"""
+import glob
+import os
+import re
+
+import pytest
+
+RAIZ = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
+TEMPLATES = sorted(glob.glob(os.path.join(RAIZ, "templates", "*.html")))
+
+# <script> con codigo: ni src= (archivo externo) ni type="application/json" (datos)
+RX_SCRIPT_EJECUTABLE = re.compile(
+    r'<script(?![^>]*\bsrc=)(?![^>]*application/json)[^>]*>(.*?)</script>', re.S)
+RX_HANDLER = re.compile(
+    r'\son(click|change|submit|input|blur|focus|keyup|keydown|load|error)\s*=\s*"')
+
+
+def _nombre(p):
+    return os.path.basename(p)
+
+
+@pytest.mark.parametrize("ruta", TEMPLATES, ids=_nombre)
+def test_template_sin_script_inline(ruta):
+    encontrados = RX_SCRIPT_EJECUTABLE.findall(open(ruta, encoding="utf-8").read())
+    assert not encontrados, (
+        f"{_nombre(ruta)} volvio a tener JS inline. Movelo a static/js/ y, si "
+        f"necesita datos del servidor, publicalos en una isla "
+        f'<script type="application/json" id="...-datos">.'
+    )
+
+
+@pytest.mark.parametrize("ruta", TEMPLATES, ids=_nombre)
+def test_template_sin_handlers_inline(ruta):
+    hallados = RX_HANDLER.findall(open(ruta, encoding="utf-8").read())
+    assert not hallados, (
+        f"{_nombre(ruta)} volvio a tener handlers inline (on{hallados[0]}=). "
+        f"Usa un atributo data-* y engancharlo desde static/js/ui.js."
+    )
+
+
+def test_csp_no_permite_scripts_inline(client):
+    r = client.get("/login")
+    csp = (r.headers.get("Content-Security-Policy")
+           or r.headers.get("Content-Security-Policy-Report-Only") or "")
+    assert csp, "no se esta emitiendo ninguna CSP"
+
+    script = next((d.strip() for d in csp.split(";") if d.strip().startswith("script-src")), "")
+    assert script, "la CSP no declara script-src"
+    assert "'unsafe-inline'" not in script, (
+        "script-src volvio a permitir 'unsafe-inline': la CSP deja de proteger "
+        "contra XSS. Revisar por que se reabrio."
+    )
+
+
+def test_csp_sigue_declarando_lo_basico(client):
+    csp = (client.get("/login").headers.get("Content-Security-Policy")
+           or client.get("/login").headers.get("Content-Security-Policy-Report-Only") or "")
+    for directiva in ("default-src", "object-src 'none'", "base-uri", "frame-ancestors"):
+        assert directiva in csp, f"falta {directiva} en la CSP"
+
+
+def test_las_islas_de_datos_son_json_valido(client, A):
+    """Una isla mal formada rompe la pantalla sin dar error de servidor."""
+    import json
+
+    A.app.config["WTF_CSRF_ENABLED"] = False
+    from conftest import make_user, login
+
+    make_user(A, "adm_csp", "ADMIN")
+    c = A.app.test_client()
+    login(c, "adm_csp")
+
+    rutas = ["/movements", "/movements/bulk", "/item-usage", "/scrap",
+             "/ingresos-egresos", "/remitos", "/metricas", "/metricas/compras",
+             "/metricas/inventario", "/metricas/descartes"]
+    vistas = 0
+    for ruta in rutas:
+        html = c.get(ruta).get_data(as_text=True)
+        for m in re.finditer(
+                r'<script type="application/json" id="([\w-]+)">\s*(.*?)\s*</script>',
+                html, re.S):
+            json.loads(m.group(2))   # revienta si no es JSON valido
+            vistas += 1
+    assert vistas >= 8, f"esperaba varias islas de datos, encontre {vistas}"
