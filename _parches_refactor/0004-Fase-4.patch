diff --git a/app.py b/app.py
index 16ac0cf..bede4b0 100644
--- a/app.py
+++ b/app.py
@@ -154,6 +154,25 @@ def _load_vendor_assets():
 VENDOR_ASSETS = _load_vendor_assets()
 
 
+@app.template_global()
+def opciones_items(items, sin_serializados=False):
+    """Items listos para un <select> del front, como datos y no como HTML.
+
+    Los templates de carga (movimientos, utilizados, descartes, ingresos) armaban
+    su lista de opciones con un `{% for %}` DENTRO del <script>, concatenando
+    JavaScript a mano. Eso obligaba a tener JS inline y era el ultimo motivo por
+    el que la CSP no podia cerrarse.
+
+    Ahora el template publica el mismo dato en una isla JSON y el JS externo lo
+    lee. El contenido es identico: value = id, text = "codigo - nombre".
+    """
+    return [
+        {"value": str(it.id), "text": f"{it.code} - {it.name}"}
+        for it in items
+        if not (sin_serializados and getattr(it, "serialized", False))
+    ]
+
+
 @app.template_global()
 def vendor_asset(name):
     """Datos de un asset de terceros para el template: url, integrity, es_local."""
@@ -193,10 +212,19 @@ CDN_ORIGINS = (
     else ""
 ).strip()
 
-# CSP en modo REPORT-ONLY por defecto: reporta lo que romperia pero NO bloquea
-# nada. Los templates usan <script>/<style> inline, asi que una CSP en enforce
-# sin 'unsafe-inline' los romperia. Para pasar a enforce (una vez validado en
-# staging) poner CSP_ENFORCE=true.
+# CSP en modo REPORT-ONLY por defecto. Para pasar a enforce (una vez validado
+# en staging) poner CSP_ENFORCE=true.
+#
+# script-src YA NO lleva 'unsafe-inline': desde la Fase 4 no queda ni un
+# <script> ejecutable ni un onclick= dentro de los templates. Los datos que el
+# servidor le pasa al front viajan en islas
+# <script type="application/json">, que NO son codigo y por lo tanto script-src
+# no las alcanza. Hay un test (test_csp_sin_js_inline.py) que falla si alguien
+# vuelve a meter JS inline, para que la politica no se rompa en silencio.
+#
+# style-src SI conserva 'unsafe-inline': los templates todavia usan atributos
+# style="..." en muchos lugares. Sacarlo es otra tarea, con su propio riesgo, y
+# no aporta lo mismo: el vector clasico de XSS es el script, no el estilo.
 # La tipografia Inter se carga desde Google Fonts (base.html). No se puede
 # aplicar SRI porque el CSS que devuelve Google varia segun el navegador, asi
 # que se declara explicitamente como origen permitido. Si en algun momento se
@@ -210,7 +238,7 @@ def _csp_directive(name, *sources):
 
 CSP_POLICY = "; ".join([
     _csp_directive("default-src", "'self'"),
-    _csp_directive("script-src", "'self'", "'unsafe-inline'", CDN_ORIGINS),
+    _csp_directive("script-src", "'self'", CDN_ORIGINS),
     _csp_directive("style-src", "'self'", "'unsafe-inline'", CDN_ORIGINS, FONT_ORIGINS),
