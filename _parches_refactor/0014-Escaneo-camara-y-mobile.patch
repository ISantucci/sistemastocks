# Parche 0014: que el escaneo funcione de verdad, tambien desde el celular
#
# Diagnostico: los dos accesos a la ficha de seriales (stock.html:109 e
# items.html:98) la abren con openDetail(), o sea dentro del iframe global de
# base.html. Ese iframe no declaraba allow="camera", y un iframe anidado no
# hereda el permiso de camara del documento principal aunque sea del mismo
# origen. Resultado: "Encender camara" fallaba SIEMPRE desde la UI, porque no
# habia ningun camino a la ficha que no pasara por el popup.
#
#  a) base.html      -> allow="camera" en el iframe del popup
#  b) item_units.html-> en modo embed, boton "Abrir en pantalla completa"
#                       (target="_top") para escanear comodo en el telefono
#  c) serial_scan.js -> qrbox calculado sobre el tamano real del visor en vez
#                       de 260x110 fijo, que en pantallas angostas hace que
#                       html5-qrcode rechace el recuadro y no arranque
#
# NO toca la base de datos. NO toca stock, movimientos ni permisos de rol.
#
--- a/templates/base.html
+++ b/templates/base.html
@@ -218,7 +218,14 @@
 <div class="modal-overlay detail-overlay" id="detail-modal">
   <div class="detail-box">
     <button type="button" class="detail-close" onclick="dismissDetail()" aria-label="Cerrar">&times;</button>
-    <iframe id="detail-frame" class="detail-frame" title="Detalle"></iframe>
+    {#- allow="camera": la ficha de seriales se abre dentro de este iframe y ahi
+        se escanean los codigos de barra. La Permissions-Policy del sitio habilita
+        la camara al documento principal, pero un iframe anidado necesita ademas
+        su propio 'allow', aunque sea del mismo origen. Sin esto el navegador le
+        niega la camara al popup y el escaneo no funciona desde Stock ni Items.
+        El iframe solo carga URLs propias (openDetail las arma en el servidor),
+        asi que no se le delega nada a terceros. #}
+    <iframe id="detail-frame" class="detail-frame" title="Detalle" allow="camera"></iframe>
   </div>
 </div>
 {% elif current_user.is_authenticated and embed %}
--- a/templates/item_units.html
