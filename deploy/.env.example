# Variables de entorno de SistemaStocksTNG.
# Copiar como .env (fuera del repo) y completar. NUNCA commitear el .env real.

# ---------------------------------------------------------------- obligatorio
# Clave de firma de la cookie de sesion. Si falta, la app arranca con una clave
# efimera y TODOS quedan deslogueados en cada reinicio.
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ------------------------------------------------------------------- rutas
STOCKS_DB_PATH=
STOCKS_BACKUP_DIR=
STOCKS_LOG_DIR=

# ------------------------------------------------------------------ servidor
APP_HOST=127.0.0.1
APP_PORT=5000
WAITRESS_THREADS=8
APP_DEBUG=false

# Proxy de adelante (Apache). Necesario para que request.is_secure sea correcto.
APP_URL_SCHEME=http
TRUSTED_PROXY=127.0.0.1
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------- seguridad
# Poner en true SOLO cuando el acceso sea por HTTPS. Con true sobre HTTP, el
# navegador no manda la cookie y nadie puede loguearse.
SESSION_COOKIE_SECURE=false

# HSTS desde la app. Si Apache ya lo manda, dejar en false para no duplicar.
# Activar unicamente con HTTPS funcionando.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# CSP: por defecto va en Report-Only (reporta, no bloquea). Pasar a true recien
# despues de validar en staging que no rompe ninguna pantalla.
CSP_ENFORCE=false

# Rate limiting (login y limite general por usuario/IP).
RATELIMIT_ENABLED=true

# Tamano maximo de request y de archivo importado, en MB.
MAX_CONTENT_LENGTH_MB=16
IMPORT_MAX_MB=8

# ---------------------------------------------------------------- rendimiento
# A partir de cuantos items el selector de items deja de volcar el catalogo
# completo en el HTML y pasa a buscar contra /api/items/search.
ITEM_PICKER_MAX_INLINE=800

# ---------------------------------------------------------------- destructivo
# Habilita /admin/reset-db. Dejar SIEMPRE apagado salvo mantenimiento puntual.
# ENABLE_RESET_DB=false

# Bootstrap del primer admin (solo en instalacion inicial).
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
