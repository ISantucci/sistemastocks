# Variables de entorno de SistemaStocksTNG.
# Copiar como .env (fuera del repo) y completar. NUNCA commitear el .env real.

# ---------------------------------------------------------------- obligatorio
# Clave de firma de la cookie de sesion. Si falta, la app arranca con una clave
# efimera y TODOS quedan deslogueados en cada reinicio.
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ------------------------------------------------------------------- rutas
STOCKS_DB_PATH=
STOCKS_BACKUP_DIR=
STOCKS_LOG_DIR=

# ------------------------------------------------------------------ servidor
APP_HOST=127.0.0.1
APP_PORT=5000
WAITRESS_THREADS=8
APP_DEBUG=false

# Proxy de adelante (Apache). Necesario para que request.is_secure sea correcto.
APP_URL_SCHEME=http
TRUSTED_PROXY=127.0.0.1
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------- seguridad
# Poner en true SOLO cuando el acceso sea por HTTPS. Con true sobre HTTP, el
# navegador no manda la cookie y nadie puede loguearse.
#
# IMPORTANTE si el sistema esta publicado en Internet con dominio propio: esto
# TIENE que estar en true. En false, la cookie de sesion viaja sin el flag
# Secure y el navegador la mandaria tambien por HTTP plano. La app avisa al
# arrancar si detecta HTTPS configurado (APP_URL_SCHEME=https o HSTS_ENABLED)
# con esta variable en false -- si ves ese [WARN] en el log, corregilo aca.
SESSION_COOKIE_SECURE=false

# HSTS desde la app. Si Apache ya lo manda, dejar en false para no duplicar.
# Activar unicamente con HTTPS funcionando.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# CSP: por defecto va en Report-Only (reporta, no bloquea). Pasar a true recien
# despues de validar en staging que no rompe ninguna pantalla.
CSP_ENFORCE=false

# Vigencia del token CSRF de los formularios, en segundos. Default 28800 (8 hs).
# El reloj arranca al abrir la pantalla: pantallas largas como /conteo necesitan
# una ventana amplia o el trabajo se pierde al guardar.
WTF_CSRF_TIME_LIMIT=28800

# Rate limiting (login y limite general por usuario/IP).
RATELIMIT_ENABLED=true

# Tamano maximo de request y de archivo importado, en MB.
MAX_CONTENT_LENGTH_MB=16
IMPORT_MAX_MB=8

# ---------------------------------------------------------------- backups
# Backup diario automatico: se hace en la primera request de cada dia. NO
# reemplaza a una tarea programada del sistema operativo (que corre aunque la
# app este caida y puede copiar a otro disco); es el piso, no el techo.
BACKUP_DAILY_ENABLED=true
# Cuantos backups DIARIOS se conservan. La purga toca unicamente los diarios:
# los manuales y los previos a una operacion destructiva no se borran nunca.
BACKUP_KEEP=30

# ---------------------------------------------------------------- rendimiento
# A partir de cuantos items el selector de items deja de volcar el catalogo
# completo en el HTML y pasa a buscar contra /api/items/search.
ITEM_PICKER_MAX_INLINE=800

# ---------------------------------------------------------------- destructivo
# Habilita /admin/reset-db. Dejar SIEMPRE apagado salvo mantenimiento puntual.
# ENABLE_RESET_DB=false

# Bootstrap del primer admin (solo en instalacion inicial).
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
